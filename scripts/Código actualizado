#' Carga de librerías
library(edgeR)
library(limma)
library(ggplot2)
library(pheatmap)
library(readxl)
library(EnhancedVolcano)
library(hipathia)

packageVersion("edgeR")

# Semilla
set.seed(19)

# Carga de la matriz de expresión
expr <- read.delim(
  "7TK4C4-expression-matrix.tsv",
  header = TRUE,
  check.names = FALSE
)

#' Copia de la matriz
matrix_exp <- expr
dim(matrix_exp)

#' matriz de conteos
counts_matrix <- matrix_exp[, grepl("_count$", colnames(matrix_exp))]
rownames(counts_matrix) <- matrix_exp$gene_id

############################################################################
# Metadatos de muestras
sample_excel <- read_excel(
  "tube_codes_plasmidsaurus.xlsx",
  col_names = "excel_name"
)

sample_excel$sample_id <- seq_len(nrow(sample_excel))

# Extraer los identificadores de las muestras
sample_id <- as.numeric(
  sub("^7TK4C4_([0-9]+)_count$", "\\1", colnames(counts_matrix))
)

# Verificar
sample_id
length(sample_id)
anyNA(sample_id)



# Emparejar cada columna de la matriz con la fila correcta del Excel
groups <- sample_excel[
  match(sample_id, sample_excel$sample_id),
]

groups$original_sample <- colnames(counts_matrix)

# Verificar el emparejamiento
stopifnot(
  !anyNA(groups$excel_name),
  all(groups$original_sample == colnames(counts_matrix))
)

all(groups$original_sample == colnames(counts_matrix))
dim(groups)


################################################################################
# Separar tratamiento, tiempo y réplica --------------------------------------
# Tratamiento
groups$treatment <- ifelse(
  grepl("^Control", groups$excel_name, ignore.case = TRUE), "control",
  ifelse(
    grepl("^Vehicle", groups$excel_name, ignore.case = TRUE), "vehicle",
    ifelse(
      grepl("^etoh", groups$excel_name, ignore.case = TRUE), "etoh",
      ifelse(
        grepl("^lipofilic", groups$excel_name, ignore.case = TRUE), "lipof",
        NA
      )
    )
  )
)

# Tiempo
groups$time <- ifelse(
  grepl("_6h_", groups$excel_name), "6",
  ifelse(grepl("_24h_", groups$excel_name), "24", NA)
)

# Réplica
groups$replicate <- as.numeric(
  sub(".*_rep", "", groups$excel_name)
)


# Condiciones usadas en edgeR
groups$condition <- paste(
  groups$treatment,
  groups$time,
  sep = "_"
)

# Nombre en figuras
display_treatment <- ifelse(
  groups$treatment == "vehicle",
  "vehiculo",
  groups$treatment
)

groups$sample <- paste0(
  display_treatment, "_",
  groups$time, "h_rep",
  groups$replicate
)

# Mantener el orden exacto de las columnas
rownames(groups) <- groups$sample

# Comprobar que los metadatos estén completos
stopifnot(
  !anyNA(groups$treatment),
  !anyNA(groups$time),
  !anyNA(groups$replicate),
  !anyDuplicated(groups$sample)
)

table(groups$condition)
head(groups)



################################################################################
# Eliminar muestras que no se incluirán en el análisis--------------------------
# Identificar las muestras que se excluirán
muestras_excluir <- (
  (groups$treatment == "control" &
     groups$time == "6" &
     groups$replicate %in% c(1, 2, 6)) |
    (groups$treatment == "vehicle" &
       groups$time == "6" &
       groups$replicate %in% c(2, 3, 4, 5))
)
muestras_excluir

# Obtener los identificadores originales de las muestras
ids_excluir <- groups$sample_id[muestras_excluir]
ids_excluir

# Identificar las columnas de conteos y CPM que se eliminarán
columnas_excluir <- grep(
  paste0(
    "^7TK4C4_(",
    paste(ids_excluir, collapse = "|"),
    ")_(count|cpm)$"
  ),
  colnames(matrix_exp),
  value = TRUE
)

# Verificar las columnas identificadas
columnas_excluir

# Guardar los nombres de las muestras excluidas
muestras_eliminadas <- groups$sample[muestras_excluir]

# Actualizar los metadatos
groups <- groups[!muestras_excluir, ]

# Eliminar las columnas únicamente de matrix_exp
matrix_exp <- matrix_exp[
  ,
  !colnames(matrix_exp) %in% columnas_excluir,
  drop = FALSE
]

# Verificar las dimensiones de la matriz modificada
dim(matrix_exp)
dim(groups)



################################################################################
#' Corrección de matriz de conteos
dim(counts_matrix)
counts_matrix <- matrix_exp[, grepl("_count$", colnames(matrix_exp))]
rownames(counts_matrix) <- matrix_exp$gene_id
dim(counts_matrix)

# Visualizar
View(counts_matrix)
dim(counts_matrix)
head(counts_matrix)
colnames(counts_matrix)

#' Verificación de que counts sea igual al orden de las filas
all(colnames(counts_matrix) == 
      colnames(matrix_exp)[grepl("_count$", colnames(matrix_exp))])

# Guradar matriz de conteos
saveRDS(counts_matrix, "matriz_conteos_depurada.rds")


#' Creación de matriz de cpm
cpm_matrix <- matrix_exp[, grepl("_cpm$", colnames(matrix_exp))]
rownames(cpm_matrix) <- matrix_exp$gene_id
View(cpm_matrix)
dim(cpm_matrix)
head(cpm_matrix)



# Renombrar matrices ------------------------------------------------------
colnames(counts_matrix) <- groups$sample

# La matriz CPM tiene el mismo orden de muestras que counts_matrix
stopifnot(
  sub("_count$", "", groups$original_sample) ==
    sub("_cpm$", "", colnames(cpm_matrix))
)

colnames(cpm_matrix) <- groups$sample



# Comprobación ------------------------------------------------------------
#' Comprobación de número de muestras
stopifnot(
  nrow(groups) == ncol(counts_matrix),
  nrow(groups) == ncol(cpm_matrix),
  !anyDuplicated(groups$sample),
  !anyNA(groups$treatment),
  !anyNA(groups$time),
  !anyNA(groups$replicate)
)

anyNA(counts_matrix)
any(counts_matrix < 0)
table(groups$condition)

# Confirmar específicamente que la muestra 21 no está
"7TK4C4_21_count" %in% groups$original_sample


# Guardar datos -----------------------------------------------------------
write.csv(
  groups,
  "sample_info_depurado.csv",
  row.names = FALSE
)

saveRDS(groups, "sample_info_depurado.rds")
saveRDS(counts_matrix, "matriz_conteos_depurado.rds")


# Revisión
# Verificar las réplicas restantes en control y vehículo a 6 h
groups[
  groups$treatment %in% c("control", "vehicle") &
    groups$time == "6",
  c("original_sample", "treatment", "time", "replicate", "sample")
]

table(groups$treatment, groups$time)



###############################################################################
# Control de calidad
# Dimensiones de la matriz de conteos
dim(counts_matrix)

# Primeros nombres de las muestras
head(colnames(counts_matrix))

# Estructura de los metadatos
names(groups)
head(groups)

# ¿Hay nombres de muestras duplicados?
anyDuplicated(colnames(counts_matrix))
anyDuplicated(groups$sample)

# ¿Hay muestras de la matriz que no estén en groups?
setdiff(colnames(counts_matrix), groups$sample)

# ¿Hay muestras de groups que no estén en la matriz?
setdiff(groups$sample, colnames(counts_matrix))

groups_qc <- as.data.frame(
  groups[match(colnames(counts_matrix), groups$sample), ]
)

stopifnot(identical(groups_qc$sample, colnames(counts_matrix)))






################################################################################
# Diseño experimental -----------------------------------------------------
# Condiciones experimentales
groups$condition <- factor(groups$condition)

# Diseño de matriz
design <- model.matrix(~0 + condition, data = groups)
colnames(design) <- levels(groups$condition)


# Creación de las comparaciones a evaluar en edgeR
contrast <-limma::makeContrasts(
  etoh_6_vs_control_6 = etoh_6 - control_6,
  etoh_24_vs_control_24 = etoh_24 - control_24,
  lipof_6_vs_vehicle_6 = lipof_6 - vehicle_6,
  lipof_24_vs_vehicle_24 = lipof_24 - vehicle_24,
  vehicle_6_vs_control_6 = vehicle_6 - control_6,
  vehicle_24_vs_control_24 = vehicle_24 - control_24,
  etoh_6_vs_etoh_24 = etoh_6 - etoh_24,
  lipof_6_vs_lipof_24 = lipof_6 - lipof_24,
  
  levels = colnames(design)
)


# Evaluación de la creación de las comparaciones     ### Quitar S.M
View(contrast)
colnames(contrast)



################################################################################
# Análisis con edgeR ------------------------------------------------------
# Creación del objeto DGEList
dge <- DGEList(
  counts = counts_matrix,
  group = groups$condition
)
dge
dim(dge)


# Filtrar genes de baja expresión
keep <- filterByExpr(dge, design)
summary(keep)       # Quitar A.F
nrow(dge)           # Quitar A.F

dge <- dge[keep, , keep.lib.sizes = FALSE]   # 16683 genes
nrow(dge)       # Quitar A.F
dim(dge)        # Quitar A.F


# Normalización con TMM
dge <- calcNormFactors(dge)
dge$samples


# Estimación de la dispersión
dge <- estimateDisp(dge, design)
dge$common.dispersion
dge$tagwise.dispersion[1:10]

plotBCV(dge)

png(
  filename = "plotBCV.png",
  width = 2400,
  height = 1800,
  res = 300
)

plotBCV(dge)
dev.off()


# Ajustar el modelo estadístico quasi-likelihood
ajuste <- glmQLFit(dge, design)


# Verificación
dim(ajuste)
dim(dge)
dge$samples$norm.factors



# Ejecución de las comparaciones ------------------------------------------
# Ejecutar los contrastes
qlf_results <- lapply(
  colnames(contrast),
  function(x) {
    glmQLFTest(
      ajuste,
      contrast = contrast[, x]
    )
  }
)

names(qlf_results) <- colnames(contrast)


# Resultados --------------------------------------------------------------
# Obtención de los resultados de las comparaciones
results <- lapply(
  qlf_results,
  function(x) {
    topTags(x, n = Inf)$table
  }
)


# Anotación génica 
annotation <- matrix_exp[, c(
  "gene_id",
  "gene_name",
  "gene_biotype"
)]

results <- lapply(
  results,
  function(result) {
    result$gene_name <- annotation$gene_name[
      match(rownames(result), annotation$gene_id)
    ]
    
    result$gene_biotype <- annotation$gene_biotype[
      match(rownames(result), annotation$gene_id)
    ]
    
    result
  }
)



################################################################################
# Selección DEGs ----------------------------------------------------------
# Seleccionar genes diferencialmente expresados
DEGs <- lapply(
  results,
  function(result) {
    result[
      result$FDR < 0.05 &
        abs(result$logFC) >= 1,
    ]
  }
)

# Verificación
dim(DEGs[["etoh_6_vs_control_6"]]) # 1451 X 7                   No igual            Kathy 1468
dim(DEGs[["etoh_24_vs_control_24"]]) # 0 X 7
dim(DEGs[["lipof_6_vs_vehicle_6"]]) # 1032 X 7                  No igual                  1056
dim(DEGs[["lipof_24_vs_vehicle_24"]]) # 221 X 7
dim(DEGs[["vehicle_6_vs_control_6"]]) # 3 X 5 //// ahora da 3 X 7
dim(DEGs[["vehicle_24_vs_control_24"]]) # 31 X 7                No igual                  29
dim(DEGs[["etoh_6_vs_etoh_24"]]) # 183 X 7
dim(DEGs[["lipof_6_vs_lipof_24"]]) # 340 X 7                    No igual                  341

# Número de DEGs por comparación
deg_summary <- data.frame(     # Es lo mismo que arriba, pero lo dejo solo para
  comparison = names(DEGs),    # comprobar con esto y lo de antes
  n_DEGs = sapply(DEGs, nrow)
)

names(DEGs)
deg_summary




# Guardar resultados ------------------------------------------------------
dir.create(
  "resultados_edgeR_depurado",
  showWarnings = FALSE
)

for (comparison in names(results)) {
  
  write.csv(
    results[[comparison]],
    file.path(
      "resultados_edgeR_depurado",
      paste0(comparison, "_todos_los_genes_depurado.csv")
    )
  )
  
  write.csv(
    DEGs[[comparison]],
    file.path(
      "resultados_edgeR_depurado",
      paste0(comparison, "_DEGs_depurado.csv")
    )
  )
}

write.csv(
  deg_summary,
  file.path("resultados_edgeR_depurado", "resumen_DEGs_depurado.csv"),
  row.names = FALSE
)



# Control de calidad de datos ---------------------------------------------
#-----------------------------------------PCA-----------------------------------
# Visualizar matriz de cpm
summary(as.vector(as.matrix(cpm_matrix)))
range(as.vector(as.matrix(cpm_matrix)))

# Conversión de cpm_matrix a escala logarítmica
#logCPM <- log2(cpm_matrix + 1)
