  n_genes = 50
)

########### HEATMAP GENERAL
# Seleccionar los 500 genes más variables
gene_variance <- apply(
  logCPM_matrix,
  1,
  var
)

top_500_genes <- names(
  sort(
    gene_variance,
    decreasing = TRUE
  )
)[1:500]

heatmap_general <- logCPM_matrix[
  top_500_genes,
  ,
  drop = FALSE
]

# Z-score por gen
heatmap_general <- t(
  scale(
    t(heatmap_general)
  )
)

# Eliminar genes con valores no finitos
heatmap_general <- heatmap_general[
  apply(
    heatmap_general,
    1,
    function(x) all(is.finite(x))
  ),
  ,
  drop = FALSE
]

# Anotación de muestras
annotation_general <- as.data.frame(
  groups[
    match(
      colnames(heatmap_general),
      groups$sample
    ),
    c("treatment", "time"),
    drop = FALSE
  ]
)

rownames(annotation_general) <-
  colnames(heatmap_general)

# Heatmap
pheatmap(
  heatmap_general,
  annotation_col = annotation_general,
  show_colnames = TRUE,
