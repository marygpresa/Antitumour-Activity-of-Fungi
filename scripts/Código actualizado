# Reactome
gsea_reactome <- lapply(
  results,
  function(result) {
    
    ranking <- make_entrez_ranking(result)
    
    gsePathway(
      geneList = ranking,
      organism = "human",
      minGSSize = 10,
      maxGSSize = 500,
      pvalueCutoff = 0.05,
      pAdjustMethod = "BH",
      verbose = FALSE
    )
  }
)

names(gsea_reactome) <- names(results)

gsea_reactome_df <- lapply(
  gsea_reactome,
  as.data.frame
)

