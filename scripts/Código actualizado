# Conversión a Entrez
head(annotation$gene_id)

gene_conversion <- bitr(
  rownames(dge),
  fromType = "ENSEMBL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db
)

nrow(gene_conversion)
head(gene_conversion)


# Estadístico F - logFC
rank <- function(result) {
  
  F <- pmax(result$F, 0)
  
  ranking <- sign(result$logFC)*sqrt(F)#~1.3% genes con empate de ranking
  
  names(ranking) <- rownames(result)
  
  ranking <- ranking[  # Elimina valores NA, Inf, -Inf, NaN
    is.finite(ranking)
  ]
  
  ranking <- sort(  #Orden de los genes: más a menos positivos
    ranking,
    decreasing = TRUE
  )
  
  return(ranking)
}


# Convertir ranking a ENTREZID
library(BiocParallel)

register(SerialParam())


make_entrez_ranking <- function(result) {
  
  ranking <- rank(result) #Asocia ENSEMBL con score
  
  ranking_df <- data.frame(  # Creación de tabla
    gene_id = names(ranking),
    score = as.numeric(ranking),
    stringsAsFactors = FALSE
  )
  
  ranking_df <- ranking_df %>%  # Agregar ENTREZID
    inner_join(
      gene_conversion,
      by = c("gene_id" = "ENSEMBL")
    )
  
  ranking_df <- ranking_df %>%
    filter(!is.na(ENTREZID)) %>%  # Eliminar NA's
    group_by(ENTREZID) %>%  # Evitar ENTREZID repetidos
    slice_max(
      order_by = abs(score),
      n = 1,
      with_ties = FALSE
    ) %>%
    ungroup()
  
  ranking <- ranking_df$score  #Nuevo ranking que asocia ENTREZID con score
  names(ranking) <- ranking_df$ENTREZID
  
  ranking <- sort(
    ranking,
    decreasing = TRUE
  )
  
  return(ranking)
}

ranking_test <- make_entrez_ranking(
  results[["etoh_6_vs_control_6"]]
)

