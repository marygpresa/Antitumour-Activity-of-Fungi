# Comparar rutas de muerte celular de la tabla y del gráfico
comparar_rutas <- function(comparacion) {
  
  tabla <- rutas_muerte_significativas |>
    dplyr::filter(Comparacion == comparacion) |>
    dplyr::select(Database, ID, Description, NES, p.adjust) |>
    dplyr::mutate(Origen = "Tabla completa")
  
  grafico <- gsea_combined_simplified_select[[comparacion]] |>
    dplyr::filter(Categoria == "Muerte celular") |>
    dplyr::select(Database, ID, Description, NES, p.adjust) |>
    dplyr::mutate(Origen = "Bar plot")
  
  dplyr::bind_rows(tabla, grafico) |>
    dplyr::arrange(Database, Description, Origen)
}

