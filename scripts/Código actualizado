# EXTRACCIÓN DE GENES POR NODO KEGG
# Comparación: etoh_24_vs_control_24
# Rutas: Autofagia, Ciclo celular y Ferroptosis

library(dplyr)
library(tidyr)
library(stringr)
library(pathview)
library(writexl)


# 1. Configuración

nodo_comparacion <- "etoh_24_vs_control_24"

nodo_rutas <- c(
  "hsa04216" = "Ferroptosis",
  "hsa04140" = "Autofagia",
  "hsa04110" = "Ciclo celular"
)

nodo_directorio <- "Extraccion_genes_por_nodo"

dir.create(
  nodo_directorio,
  recursive = TRUE,
  showWarnings = FALSE
)



# 2. Extracción de genes por nodo

nodo_extraer_genes <- function(comparison, pathway_id, ruta) {
  
  message("Procesando: ", ruta)
  
  # Obtener genes de la ruta y sus Leading Edge
  nodo_info <- make_kegg_gene_table_allfc(
    comparison,
    pathway_id
  )
  
  nodo_tabla <- nodo_info$genes
  
  nodo_leading_ids <- as.character(nodo_info$leading_ids)
  
  if (nrow(nodo_tabla) == 0) {
    warning("No hay genes disponibles para: ", pathway_id)
    return(NULL)
  }
  
  # Preparar valores de logFC
  nodo_valores <- nodo_tabla$logFC
  
  names(nodo_valores) <- as.character(nodo_tabla$ENTREZID)
  
  # Directorio de salida de Pathview
  nodo_subdirectorio <- file.path(
    nodo_directorio,
    comparison,
    pathway_id
  )
  
  dir.create(
    nodo_subdirectorio,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  # Generar mapa Pathview
  nodo_pv <- pathview::pathview(
    gene.data = nodo_valores,
    pathway.id = pathway_id,
    species = "hsa",
    gene.idtype = "entrez",
    kegg.native = TRUE,
    plot.col.key = FALSE,
    na.col = "#D3D3D3",
    low = list(gene = "#2166AC"),
    mid = list(gene = "#F7F7F7"),
    high = list(gene = "#B2182B"),
    limit = list(gene = 0.5, cpd = 1),
    bins = list(gene = 100, cpd = 10),
    both.dirs = list(gene = TRUE, cpd = TRUE),
    node.sum = "max.abs",
    out.suffix = paste0(comparison, "_", pathway_id, "_revision"),
    kegg.dir = nodo_subdirectorio
  )
  
  # Recuperar información de los nodos físicos
  nodo_nodos <- nodo_pv$plot.data.gene %>%
    dplyr::filter(type == "gene") %>%
    dplyr::distinct(
      x, y, width, height,
      kegg.names, labels, all.mapped,
      .keep_all = TRUE
    ) %>%
    dplyr::filter(
      !is.na(all.mapped),
      trimws(all.mapped) != ""
    ) %>%
    dplyr::mutate(
      Node_id = paste(x, y, width, height, sep = "_"),
      Node_label = labels,
      Node_kegg = kegg.names,
      Node_genes = all.mapped
    )
  
  # Expandir los genes asociados a cada nodo
  nodo_genes <- nodo_nodos %>%
    dplyr::mutate(
      ENTREZID = stringr::str_split(all.mapped, ",")
    ) %>%
    tidyr::unnest(ENTREZID) %>%
    dplyr::mutate(
      ENTREZID = trimws(as.character(ENTREZID))
    ) %>%
    dplyr::filter(
      !is.na(ENTREZID),
      ENTREZID != ""
    )
  
  # Incorporar anotación, logFC, FDR y Leading Edge
  nodo_genes <- nodo_genes %>%
    dplyr::left_join(
      nodo_tabla %>%
        dplyr::mutate(
          ENTREZID = as.character(ENTREZID)
        ),
      by = "ENTREZID"
    ) %>%
    dplyr::mutate(
      Comparacion = comparison,
      Ruta = ruta,
      KEGG_ID = pathway_id,
      LeadingEdge = ENTREZID %in% nodo_leading_ids
    ) %>%
    dplyr::select(
      Comparacion,
      Ruta,
      KEGG_ID,
      Node_id,
      Node_label,
      Node_kegg,
      Node_genes,
      ENTREZID,
      gene_name,
      LeadingEdge,
      logFC,
      FDR
    )
  
  return(nodo_genes)
}


# 3. Ejecutar la estracción para las 3 rutas

nodo_resultados <- lapply(
  names(nodo_rutas),
  function(id) {
    
    nodo_extraer_genes(
      comparison = nodo_comparacion,
      pathway_id = id,
      ruta = unname(nodo_rutas[id])
    )
  }
)

# Unir las tres rutas
nodo_genes_definitivos <- dplyr::bind_rows(
  nodo_resultados
)


# 4. Crear tabla solo de leading edge

nodo_leading_edge_definitivo <- nodo_genes_definitivos %>%
  dplyr::filter(LeadingEdge == TRUE)


# 5. Exportar tablas a excel


writexl::write_xlsx(
  list(
    "Genes por nodo" = nodo_genes_definitivos,
    "Solo leading edge" = nodo_leading_edge_definitivo
  ),
  file.path(
    nodo_directorio,
    "Genes_por_nodo_LE_etoh_24_vs_control_24.xlsx"
  )
)
