# GSEA KEGG - INCLUIR RUTAS SIGNIFICATIVAS Y NO SIGNIFICATIVAS
gsea_kegg_death <- lapply(
  results,
  function(result) {
    
    ranking <- make_entrez_ranking(result)
    
    gseKEGG(
      geneList = ranking,
      organism = "hsa",
      minGSSize = 10,
      maxGSSize = 500,
      pvalueCutoff = 1, # Para incluir significativos y no significativos
      pAdjustMethod = "BH",
      eps = 0,
      nPermSimple = 10000,
      verbose = FALSE
    )
  }
)

names(gsea_kegg_death) <- names(results)

# RUTAS KEGG DE INTERÉS
death_pathways <- c(
  "hsa04210" = "Apoptosis",
  "hsa04217" = "Necroptosis",
  "hsa04216" = "Ferroptosis",
  "hsa04140" = "Autofagia",
  "hsa04621" = "Señalización NOD-like (piroptosis)",
  "hsa04110" = "Ciclo celular (catástrofe mitótica)"
)

# Obtener tablas de todos los contrastes
kegg_death_df <- lapply(
  names(gsea_kegg_death),
  function(comparison) {
    
    df <- as.data.frame(
      gsea_kegg_death[[comparison]]
    )
    
    if (nrow(df) == 0) return(NULL)
    
    df %>%
      filter(ID %in% names(death_pathways)) %>%
      mutate(
        Comparison = comparison,
        Proceso = unname(death_pathways[ID]),
        Significativo = ifelse(
          !is.na(p.adjust) & p.adjust < 0.05,
          "Sí",
          "No"
        )
      )
  }
)

names(kegg_death_df) <- names(gsea_kegg_death)

# Dotplot - FDR NES Muerte celular
plot_kegg_death <- function(comparison) {
  
  df <- kegg_death_df[[comparison]]
  
  if (is.null(df) || nrow(df) == 0) {
    message("No hay rutas disponibles para: ", comparison)
    return(NULL)
  }
  
  df <- df %>%
    filter(
      !is.na(NES),
      is.finite(NES),
      !is.na(p.adjust)
    ) %>%
    mutate(
      FDR_plot = pmax(p.adjust, 1e-16),
      Proceso = factor(
        Proceso,
        levels = rev(unname(death_pathways))
      )
    )
  
  if (nrow(df) == 0) return(NULL)
  
  ggplot(
    df,
    aes(x = NES, y = Proceso)
  ) +
    geom_vline(
      xintercept = 0,
      linetype = "dashed",
      color = "grey60"
    ) +
    geom_point(
      aes(
        size = setSize,
        color = FDR_plot,
        shape = Significativo
      ),
      stroke = 1.2
    ) +
    scale_x_continuous(
      breaks = function(x) {
        seq(
          floor(x[1] * 2) / 2,
          ceiling(x[2] * 2) / 2,
          by = 0.5
        )
      }
    ) +
    scale_color_gradient(
      low = "#B2182B",
      high = "#2166AC",
      trans = "log10",
      name = "FDR (BH)"
    ) +
    scale_shape_manual(
      values = c("Sí" = 16, "No" = 1),
      name = "FDR < 0.05"
    ) +
    scale_size_continuous(
      name = "Genes en el conjunto"
    ) +
    labs(
      title = paste(
        "KEGG - Muerte celular",
        comparison,
        sep = "\n"
      ),
      x = "Normalized Enrichment Score (NES)",
      y = NULL
    ) +
    theme_classic(base_size = 12) +
    theme(
      plot.title = element_text(
        face = "bold",
        hjust = 0.5
      ),
      axis.text.y = element_text(size = 10),
      panel.grid.major.y = element_blank(),
      legend.position = "right"
    )
}


