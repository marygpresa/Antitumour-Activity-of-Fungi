# Gráfico Heatmaps de correlación
plot_correlation_heatmap <- function(
    expression_matrix,
    title) {
  
  expresion_matrix <- as.matrix(expression_matrix)
  
  correlation_matrix <- cor(
    expression_matrix
  )
  
  annotation_samples <- as.data.frame(
    groups[
      match(
        colnames(correlation_matrix),
        groups$sample
    ),
    c("treatment", "time"),
    drop = FALSE
  ]
  )
  
  rownames(annotation_samples) <-
    colnames(correlation_matrix)
  
  pheatmap(
    correlation_matrix,
    annotation_col = annotation_samples,
    annotation_row = annotation_samples,
    main = title
  )
}

# General
plot_correlation_heatmap(
  logCPM_matrix,
  "Correlación entre muestras - General"
)

# EtOH
plot_correlation_heatmap(
  logCPM_etoh,
  "Correlación entre muestras - EtOH"
)

# Lipof
plot_correlation_heatmap(
  logCPM_lipof,
  "Correlación entre muestras - Lipof"
)




