    EtOH_6h = genes_etoh_interes[["etoh_6_vs_control_6"]],
    EtOH_24h = genes_etoh_interes[["etoh_24_vs_control_24"]]
  ),
  "DEGs_rutas_interes_EtOH.xlsx"
)


