# PCA - EtOH 24 h
# Control 24 h + EtOH 24 h
# ============================================================================

# Seleccionar muestras
samples_etoh_24 <- groups$sample[
  groups$condition %in% c(
    "control_24",
    "etoh_24"
  )
]

# Submatriz de expresión
logCPM_etoh_24 <- logCPM_matrix[
  ,
  samples_etoh_24,
  drop = FALSE
]

# PCA
pca_etoh_24 <- prcomp(
  t(logCPM_etoh_24),
