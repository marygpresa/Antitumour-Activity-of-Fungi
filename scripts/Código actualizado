# Filtrar las rutas de interés de la tabla KEGG existente
genes_interes_kegg <- tabla_genes_kegg %>%
  dplyr::filter(Ruta %in% rutas_interes) %>%
  dplyr::distinct(Ruta, Entrez, Simbolo)

# Comparaciones de EtOH
comparaciones_etoh <- c(
  "etoh_6_vs_control_6",
  "etoh_24_vs_control_24"
)

# Extraer DEGs asociados a las rutas de interés
genes_etoh_interes <- lapply(comparaciones_etoh, function(comp) {
  
  tabla <- results[[comp]] %>%
    tibble::rownames_to_column("gene_id") %>%
    dplyr::filter(
      FDR < 0.05,
      abs(logFC) >= 1,
      !is.na(gene_name),
      gene_name != ""
    )
  
  # Relacionar los DEGs con las rutas KEGG
  tabla %>%
    dplyr::inner_join(
      genes_interes_kegg,
      by = c("gene_name" = "Simbolo")
    ) %>%
    dplyr::mutate(
      Comparacion = comp,
      Regulacion = as.character(
        ifelse(logFC > 0, "Sobreexpresado", "Subexpresado")
      )
    ) %>%
    dplyr::select(
      Comparacion,
      Ruta,
      gene_id,
      gene_name,
      Entrez,
      logFC,
      logCPM,
      PValue,
      FDR,
      Regulacion
    ) %>%
    dplyr::arrange(Ruta, FDR)
  
})

# Asignar nombres a las tablas
names(genes_etoh_interes) <- comparaciones_etoh

# Unir los resultados de ambas comparaciones
tabla_final_etoh <- dplyr::bind_rows(genes_etoh_interes)

# Creación del archivo
