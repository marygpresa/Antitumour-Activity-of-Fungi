# GSEA de KEGG------------------------------------------------------------------
gsea_kegg <- lapply(
  results,
  function(result) {
    
    ranking <- make_entrez_ranking(result)#~1.3% genes con empate de ranking
    
    gseKEGG(
      geneList = ranking,
      organism = "hsa",
      minGSSize = 10,
      maxGSSize = 500,
      pvalueCutoff = 0.05,
      pAdjustMethod = "BH",
      verbose = FALSE,
      eps = 0,
      nPermSimple = 10000
    )
