library(KEGGREST)

rutas_kegg <- c(
  Apoptosis = "hsa04210",
  Necroptosis = "hsa04217",
  Ferroptosis = "hsa04216",
  Ciclo_celular = "hsa04110",
  Autofagia = "hsa04140",
  Senalizacion_p53 = "hsa04115",
  Reparacion_NER = "hsa03430",
  Reparacion_BER = "hsa03440",
)



# Descargar cada ruta y extraer sus genes
genes_por_ruta <- lapply(rutas_kegg, function(id_ruta) {
  
  ruta <- KEGGREST::keggGet(id_ruta)[[1]]
  
  entradas <- ruta$GENE
  
  # KEGG almacena alternativamente ID y descripción
  ids <- entradas[seq(1, length(entradas), by = 2)]
  
  # Extraer el identificador Entrez Gene de las entradas KEGG
  sub("^.*:", "", ids)
})

genes_kegg_prioritarios <- unique(
  unlist(genes_por_ruta, use.names = FALSE)
)

length(genes_kegg_prioritarios)
head(genes_kegg_prioritarios)
head(results[["etoh_6_vs_control_6"]]$gene_name)

# Tabla
tabla_genes_por_ruta <- lapply(names(rutas_kegg), function(nombre) {
  
  ruta <- KEGGREST::keggGet(rutas_kegg[[nombre]])[[1]]
  entradas <- ruta$GENE
  
  # KEGG alterna identificador y descripción del gen
  ids <- entradas[seq(1, length(entradas), by = 2)]
  descripciones <- entradas[seq(2, length(entradas), by = 2)]
  
  simbolos <- trimws(sub(";.*$", "", descripciones))
  
  data.frame(
    Ruta = nombre,
    Entrez = ids,
    Simbolo = simbolos,
    stringsAsFactors = FALSE
  )
})

tabla_genes_kegg <- do.call(rbind, tabla_genes_por_ruta)

