# Filtrar matriz de CPM
#logCPM_matrix <- logCPM[keep, ]  # Esta matriz también se filtra quitando los
#View(logCPM_matrix)              # pocos conteos?
#dim(logCPM_matrix)
#colnames(logCPM_matrix)

# Expresión logCPM normalizada por TMM
logCPM_matrix <- edgeR::cpm(
  dge,
  log = TRUE,
  prior.count = 1
)

# Mantener compatibilidad con los heatmaps de DEGs
logCPM <- logCPM_matrix




################################################################################
# PCA por tratamiento fúngco----------------------------------------------------
# Determinación de las condiciones
get_samples <- function(treatments) {
  groups$sample[
    groups$treatment %in% treatments
  ]
}

samples_etoh <- get_samples(
  c("control", "etoh")
)

samples_lipof <- get_samples(
  c("control", "vehicle", "lipof")
)


# Matriz de pca para cada condición
logCPM_etoh <- logCPM_matrix[
  ,
  samples_etoh,
  drop = FALSE
]

logCPM_lipof <- logCPM_matrix[
  ,
  samples_lipof,
  drop = FALSE
]


# Cálculo de PCA
pca_etoh <- prcomp(t(logCPM_etoh),
                   scale. = FALSE # Estandarización de la escala
)             # ¿Es necesario?

pca_lipof <- prcomp(t(logCPM_lipof),
                    scale. = FALSE # Estandarización de la escala
)              # ¿Es necesario?


# Datos para gráficos
# 1-EtOH
groups_etoh <- groups[
  match(
    rownames(pca_etoh$x),
    groups$sample
  ),
]

groups_lipof <- groups[
  match(
    rownames(pca_lipof$x),
    groups$sample
  ),
]

percent_var_etoh <- 100 *
  pca_etoh$sdev^2 /
  sum(pca_etoh$sdev^2)

percent_var_lipof <- 100 *
  pca_lipof$sdev^2 /
  sum(pca_lipof$sdev^2)


# Porcentaje de variación
percent_var_etoh <- 100 * pca_etoh$sdev^2/sum(pca_etoh$sdev^2)
percent_var_lipof <- 100 * pca_lipof$sdev^2/sum(pca_lipof$sdev^2)


# Gráfico
# 1- EtOH
par(
  mar = c(5, 5, 5, 8),
  xpd = NA
)

colors_etoh <- c(
  "control_6" = "#BA68CB",
  "etoh_6" = "#1976D2",
  "control_24" = "#FFB74D",
  "etoh_24" = "#81C7B4"
)
plot(pca_etoh$x[,1], 
     pca_etoh$x[,2],
     xlab = paste0("PC1 (", round(percent_var_etoh[1], 1), "%)"),
     ylab = paste0("PC2 (", round(percent_var_etoh[2], 1), "%)"),
     main = "PCA EtOH",
     pch = 19,
     cex = 2,
     col = colors_etoh[as.character(groups_etoh$condition)],
     xlim = range(pca_etoh$x[,1]) * 1.1,
     ylim = range(pca_etoh$x[,2]) * 1.1
)

legend("topright",
       inset = c(-0.13, 0),
       legend = names(colors_etoh),
       col = colors_etoh,
       pch = 19,
       pt.cex = 2,
       xpd = TRUE,
       bty = "n"
)



# 1- Lipof
par(
  mar = c(5, 5, 5, 8),
  xpd = NA
)

colors_lipof <- c(
  "control_6" = "#2A0081",
  "lipof_6" = "#B7E7FC",
  "vehicle_6" = "#F58B0C",
  "control_24" = "#CF3068",
  "lipof_24" = "#E884C6",
  "vehicle_24" = "#F5C700"
)
plot(pca_lipof$x[,1], pca_lipof$x[,2],
     xlab = paste0("PC1 (", round(percent_var_lipof[1], 1), "%)"),
     ylab = paste0("PC2 (", round(percent_var_lipof[2], 1), "%)"),
     main = "PCA Lipofílico",
     pch = 19,
     cex = 2,
     col = colors_lipof[as.character(groups_lipof$condition)],
     xlim = range(pca_lipof$x[,1]) * 1.1,
     ylim = range(pca_lipof$x[,2]) * 1.1
)

legend("topright",
       inset = c(-0.15, 0),
       legend = names(colors_lipof),
       col = colors_lipof,
       pch = 19,
       pt.cex = 2,
       xpd = TRUE,
       bty = "n"
)



