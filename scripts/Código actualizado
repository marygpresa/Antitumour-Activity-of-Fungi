logfc_palette <- colorRampPalette(c("#2166AC", "#F7F7F7", "#B2182B"))(100)

# Preparar resultados de EdgeR - log2FC de todos los genes
prepare_kegg_genes_allfc <- function(comparison) {
  
  result <- results[[comparison]]
  
  genes_df <- data.frame(
    ENSEMBL = rownames(result),
    logFC = result$logFC,
    FDR = result$FDR,
    PValue = result$PValue,
    F = result$F,
    gene_name = result$gene_name,
    gene_biotype = result$gene_biotype,
    stringsAsFactors = FALSE
  ) %>%
    left_join(
      gene_conversion %>%
        dplyr::select(ENSEMBL, ENTREZID) %>%
        dplyr::distinct(),
      by = "ENSEMBL"
    ) %>%
    filter(
      !is.na(ENTREZID),
      is.finite(logFC)
    ) %>%
    arrange(
      ENTREZID,
      desc(abs(logFC)),
      ENSEMBL
    ) %>%
    distinct(ENTREZID, .keep_all = TRUE) %>%
    mutate(
      ENTREZID = as.character(ENTREZID),
      DEG = !is.na(FDR) & FDR < 0.05 & abs(logFC) >= 1
    )
  
  return(genes_df)
}


# Extraer los genes del leading edge para una ruta y comparación
get_leading_edge_ids <- function(comparison, pathway_id) {
  
  gsea_obj <- gsea_kegg_death[[comparison]]
  
  if (is.null(gsea_obj)) {
    return(character(0))
  }
  
  gsea_df <- as.data.frame(gsea_obj)
  
  pathway_row <- gsea_df %>%
    filter(!is.na(ID), ID == pathway_id)
  
  if (nrow(pathway_row) == 0) {
    return(character(0))
  }
  
  core <- pathway_row$core_enrichment[1]
  
  if (is.na(core) || !nzchar(core)) {
    return(character(0))
  }
  
  leading_genes <- strsplit(core, "/", fixed = TRUE)[[1]]
  leading_genes <- unique(as.character(leading_genes))
  
  return(leading_genes)
}

# Según KEGG
get_pathway_gene_ids <- function(comparison, pathway_id) {
  
  gsea_obj <- gsea_kegg_death[[comparison]]
  
  if (is.null(gsea_obj)) {
    return(character(0))
  }
  
  pathway_genes <- gsea_obj@geneSets[[pathway_id]]
  
  if (is.null(pathway_genes)) {
    return(character(0))
  }
  
  return(as.character(pathway_genes))
}

# Tablas
make_kegg_gene_table_allfc <- function(comparison, pathway_id) {
  
  genes_df <- prepare_kegg_genes_allfc(comparison)
  pathway_genes <- get_pathway_gene_ids(comparison, pathway_id)
  leading_ids <- get_leading_edge_ids(comparison, pathway_id)
  
  if (length(pathway_genes) == 0) {
    stop("Ruta no disponible en GSEA para ", comparison, " | ", pathway_id)
  }
  
  tabla <- genes_df %>%
    filter(ENTREZID %in% pathway_genes) %>%
    mutate(
      LeadingEdge = ENTREZID %in% leading_ids,
      Comparison = comparison,
      KEGG_ID = pathway_id
    ) %>%
    arrange(desc(LeadingEdge), FDR, desc(abs(logFC)))
  
  return(list(
    genes = tabla,
    leading_ids = leading_ids,
    pathway_ids = pathway_genes
  ))
}




# Solucionar lo de la leyenda del log2FC
save_compact_logfc_legend <- function(output_file, limit_logFC = 3) {
  
  df <- data.frame(
    x = seq(-limit_logFC, limit_logFC, length.out = 200),
    y = 1
  )
  
  p <- ggplot(df, aes(x = x, y = y, fill = x)) +
    geom_tile() +
    scale_fill_gradient2(
      low = "#2166AC",
      mid = "#F7F7F7",
      high = "#B2182B",
      midpoint = 0,
      limits = c(-limit_logFC, limit_logFC),
      name = "log2FC"
    ) +
    scale_x_continuous(
      breaks = c(-limit_logFC, 0, limit_logFC)
    ) +
    theme_void() +
    theme(
      legend.position = "bottom",
      axis.text.x = element_text(size = 8, colour = "black"),
      axis.ticks.x = element_line(colour = "black"),
      plot.margin = margin(2, 2, 2, 2)
    )
  
  ggsave(
    filename = output_file,
    plot = p,
    width = 4,
    height = 1.2,
    dpi = 300,
    bg = "white"
  )
}

# Bordes
hex_to_rgb01 <- function(hex) {
  rgb <- grDevices::col2rgb(hex) / 255
  as.numeric(rgb[,1])
}

paint_pixels <- function(img, rows, cols, color_hex) {
  
  rows <- rows[rows >= 1 & rows <= dim(img)[1]]
  cols <- cols[cols >= 1 & cols <= dim(img)[2]]
  
  if (!length(rows) || !length(cols)) return(img)
  
  rgb <- hex_to_rgb01(color_hex)
  
  for (ch in 1:3) {
    img[rows, cols, ch] <- rgb[ch]
  }
  
  if (dim(img)[3] == 4) {
    img[rows, cols, 4] <- 1
  }
  
  return(img)
}


# Sólidos
draw_solid_border <- function(img, left, right, top, bottom,
                              color_hex = "#000000", border_width = 3) {
  
  for (b in seq_len(border_width) - 1L) {
    img <- paint_pixels(img, top + b, left:right, color_hex)
    img <- paint_pixels(img, bottom - b, left:right, color_hex)
    img <- paint_pixels(img, top:bottom, left + b, color_hex)
    img <- paint_pixels(img, top:bottom, right - b, color_hex)
  }
  
  return(img)
}

# Dashed
draw_dashed_border <- function(img, left, right, top, bottom,
                               color_hex = "#000000",
                               border_width = 3,
                               dash_len = 10,
                               gap_len = 6) {
  
  pattern_step <- dash_len + gap_len
  
  x_seq <- left:right
  y_seq <- top:bottom
  
  for (b in seq_len(border_width) - 1L) {
    
    # arriba y abajo
    keep_x <- x_seq[((seq_along(x_seq) - 1) %% pattern_step) < dash_len]
    img <- paint_pixels(img, top + b, keep_x, color_hex)
    img <- paint_pixels(img, bottom - b, keep_x, color_hex)
    
    # izquierda y derecha
    keep_y <- y_seq[((seq_along(y_seq) - 1) %% pattern_step) < dash_len]
    img <- paint_pixels(img, keep_y, left + b, color_hex)
    img <- paint_pixels(img, keep_y, right - b, color_hex)
  }
  
  return(img)
}


# Mapas individuales TODOS los Log2FC -------------------------------------

# MAPAS KEGG: log2FC de todos los genes + bordes negros LE

plot_kegg_logfc_le_map <- function(
    comparison,
    pathway_id,
    out_dir = "Mapas_logFC_LE",
    limit_logFC = 0.5,
    border_width = 3
) {
  
  # 1. Preparar los datos
  info <- make_kegg_gene_table_allfc(
    comparison,
    pathway_id
  )
  
  tabla <- info$genes
  
  if (nrow(tabla) == 0) {
    stop("No hay genes mapeados para esta ruta.")
  }
  
  # 2. Crear carpeta de resultados
  comp_dir <- file.path(
    out_dir,
    comparison,
    pathway_id
  )
  
  dir.create(
    comp_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  # 3. Guardar todos los valores log2FC
  gene_values <- tabla$logFC
  names(gene_values) <- as.character(tabla$ENTREZID)
  
  stopifnot(
    length(gene_values) > 0,
    all(is.finite(gene_values)),
    !anyDuplicated(names(gene_values))
  )
  
  message("Genes con log2FC: ", length(gene_values))
  message("Genes LE: ", length(info$leading_ids))
  
  # 4. Generar mapa KEGG
  suffix <- paste0(
    comparison, "_", pathway_id, "_allFC"
  )
  
  original_name <- paste0(
    pathway_id, ".", suffix, ".png"
  )
  
  pv <- pathview::pathview(
    gene.data = gene_values,
    pathway.id = pathway_id,
    species = "hsa",
    gene.idtype = "entrez",
    kegg.native = TRUE,
    
    # Eliminar barra interna
    plot.col.key = FALSE,
    
    na.col = "#D3D3D3",
    
    low = list(gene = "#2166AC"),
    mid = list(gene = "#F7F7F7"),
    high = list(gene = "#B2182B"),
    
    limit = list(
      gene = limit_logFC,
      cpd = 1
    ),
    
    bins = list(
      gene = 100,
      cpd = 10
    ),
    
    both.dirs = list(
      gene = TRUE,
      cpd = TRUE
    ),
    
    node.sum = "max.abs",
    out.suffix = suffix,
    kegg.dir = comp_dir
  )
  
  if (is.null(pv$plot.data.gene)) {
    stop("Pathview no devolvió los nodos génicos.")
  }
  
  # 5. Localizar el PNG generado por Pathview
  possible_files <- c(
    file.path(comp_dir, original_name),
    file.path(getwd(), original_name)
  )
  
  existing_files <- unique(
    possible_files[file.exists(possible_files)]
  )
  
  if (length(existing_files) == 0) {
    stop(
      "No se encontró el PNG generado: ",
      original_name
    )
  }
  
  # Si hay más de una copia, seleccionar la modificada más recientemente
  file_info <- file.info(existing_files)
  original_file <- existing_files[
    which.max(file_info$mtime)
  ]
  
  message("PNG utilizado como base: ", original_file)
  
  # 6. Leer imagen y nodos
  img <- png::readPNG(original_file)
  
  plot_data <- pv$plot.data.gene
  
  if ("all.mapped" %in% names(plot_data)) {
    node_ids <- as.character(plot_data$all.mapped)
  } else {
    node_ids <- as.character(plot_data$kegg.names)
  }
  
  # 7. Identificar nodos que contienen genes LE
  has_leading <- vapply(
    node_ids,
    function(ids) {
      
      if (is.na(ids) || !nzchar(ids)) {
        return(FALSE)
      }
      
      genes_nodo <- trimws(
        unlist(
          strsplit(ids, "[,;/[:space:]]+")
        )
      )
      
      any(
        genes_nodo %in%
          as.character(info$leading_ids)
      )
    },
    logical(1)
  )
  
  selected_nodes <- plot_data[
    has_leading,
    ,
    drop = FALSE
  ]
  
  message(
    "Nodos con LE identificados: ",
    nrow(selected_nodes)
  )
  
  # 8. Dibujar los bordes negros
  for (i in seq_len(nrow(selected_nodes))) {
    
    node <- selected_nodes[i, ]
    
    x <- as.numeric(node$x)
    y <- as.numeric(node$y)
    
    nw <- as.numeric(node$width)
    nh <- as.numeric(node$height)
    
    if (!all(is.finite(c(x, y, nw, nh)))) {
      next
    }
    
    left <- round(x - nw / 2)
    right <- round(x + nw / 2)
    
    top <- round(y - nh / 2)
    bottom <- round(y + nh / 2)
    
    img <- draw_solid_border(
      img,
      left,
      right,
      top,
      bottom,
      color_hex = "#000000",
      border_width = border_width
    )
  }
  
  # 9. Guardar el mapa final
  final_file <- file.path(
    comp_dir,
    paste0(pathway_id, "_logFC_LE.png")
  )
  
  png::writePNG(img, final_file)
  
  # 10. Guardar tabla de respaldo
  write.csv(
    tabla,
    file.path(
      comp_dir,
      paste0(pathway_id, "_genes_allFC.csv")
    ),
    row.names = FALSE
  )
  
  message("Mapa final guardado: ", final_file)
  
  return(invisible(final_file))
}



# Ejecutar todos los mapas
for (trt in names(comparison_pairs)) {
  
  for (cmp in c(comparison_pairs[[trt]]$h6, comparison_pairs[[trt]]$h24)) {
    
    for (pathway_id in names(death_pathways)) {
      
      message("Procesando mapa logFC + LE: ", cmp, " | ", pathway_id)
      
      tryCatch(
        plot_kegg_logfc_le_map(
          comparison = cmp,
          pathway_id = pathway_id,
          out_dir = "Mapas_logFC_LE",
          limit_logFC = 0.5,
          border_width = 3
        ),
        error = function(e) {
          message("Error en ", cmp, " | ", pathway_id, ": ", conditionMessage(e))
        }
      )
    }
  }
}




# Mapas con LE genes compartidos/exclusivos -------------------------------
# Clasificación de genes y nodos
classify_node_status <- function(node_gene_ids, le6, le24) {
  
  node_gene_ids <- unique(node_gene_ids)
  
  shared_ids <- intersect(le6, le24)
  excl6_ids <- setdiff(le6, le24)
  excl24_ids <- setdiff(le24, le6)
  
  has_shared <- any(node_gene_ids %in% shared_ids)
  has_excl6 <- any(node_gene_ids %in% excl6_ids)
  has_excl24 <- any(node_gene_ids %in% excl24_ids)
  
  if (has_shared && !has_excl6 && !has_excl24) {
    return("shared")
  }
  
  if (!has_shared && has_excl6 && !has_excl24) {
    return("exclusive6")
  }
  
  if (!has_shared && !has_excl6 && has_excl24) {
    return("exclusive24")
  }
  
  if (!has_shared && has_excl6 && has_excl24) {
    return("hetero_noshared")
  }
  
  if (has_shared && (has_excl6 || has_excl24)) {
    return("hetero_shared")
  }
  
  return(NA_character_)
}

# Mapas

# MAPAS KEGG: leading edge compartidos y exclusivos
# Un mapa por tratamiento y ruta, integrando 6 h y 24 h

plot_kegg_shared_exclusive_map <- function(
    treatment,
    pathway_id,
    out_dir = "Mapas_shared_exclusive",
    border_width = 4
) {
  
  # 1. Identificar las comparaciones
  cmp6 <- comparison_pairs[[treatment]]$h6
  cmp24 <- comparison_pairs[[treatment]]$h24
  
  # 2. Recuperar los leading edge genes
  le6 <- get_leading_edge_ids(cmp6, pathway_id)
  le24 <- get_leading_edge_ids(cmp24, pathway_id)
  
  message("LE 6 h: ", length(le6))
  message("LE 24 h: ", length(le24))
  message("LE compartidos: ", length(intersect(le6, le24)))
  
  # 3. Crear carpeta
  trt_dir <- file.path(out_dir, treatment, pathway_id)
  
  dir.create(
    trt_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  # 4. Recuperar genes de la ruta en ambos tiempos
  genes_base <- unique(c(
    get_pathway_gene_ids(cmp6, pathway_id),
    get_pathway_gene_ids(cmp24, pathway_id)
  ))
  
  if (length(genes_base) == 0) {
    stop("No hay genes de la ruta para este tratamiento.")
  }
  
  # 5. Crear valores neutros
  base_values <- rep(0, length(genes_base))
  names(base_values) <- genes_base
  
  suffix <- paste0(
    treatment, "_", pathway_id, "_sharedexclusive"
  )
  
  original_name <- paste0(
    pathway_id, ".", suffix, ".png"
  )
  
  # 6. Generar mapa base con Pathview
  pv <- pathview::pathview(
    gene.data = base_values,
    pathway.id = pathway_id,
    species = "hsa",
    gene.idtype = "entrez",
    kegg.native = TRUE,
    plot.col.key = FALSE,
    
    na.col = "#D3D3D3",
    low = list(gene = "#F2F2F2"),
    mid = list(gene = "#F2F2F2"),
    high = list(gene = "#F2F2F2"),
    
    limit = list(gene = 1, cpd = 1),
    bins = list(gene = 10, cpd = 10),
    both.dirs = list(gene = FALSE, cpd = FALSE),
    
    node.sum = "max.abs",
    out.suffix = suffix,
    kegg.dir = trt_dir
  )
  
  if (is.null(pv$plot.data.gene)) {
    stop("Pathview no devolvió los nodos.")
  }
  
  # 7. Buscar el PNG donde realmente se guardó
  possible_files <- c(
    file.path(getwd(), original_name),
    file.path(trt_dir, original_name)
  )
  
  existing_files <- possible_files[
    file.exists(possible_files)
  ]
  
  if (length(existing_files) == 0) {
    stop(
      "No se encontró el mapa base: ",
      original_name
    )
  }
  
  original_file <- existing_files[1]
  
  # 8. Leer imagen y nodos
  img <- png::readPNG(original_file)
  plot_data <- pv$plot.data.gene
  
  node_ids <- if ("all.mapped" %in% names(plot_data)) {
    as.character(plot_data$all.mapped)
  } else {
    as.character(plot_data$kegg.names)
  }
  
  # 9. Clasificar y dibujar bordes
  node_summary <- list()
  n_marked <- 0L
  
  for (i in seq_len(nrow(plot_data))) {
    
    node <- plot_data[i, ]
    ids <- node_ids[i]
    
    if (is.na(ids) || !nzchar(ids)) next
    
    genes_nodo <- trimws(
      unlist(strsplit(ids, "[,;/[:space:]]+"))
    )
    
    genes_nodo <- genes_nodo[genes_nodo != ""]
    
    status <- classify_node_status(
      genes_nodo,
      le6,
      le24
    )
    
    if (is.na(status)) next
    
    x <- as.numeric(node$x)
    y <- as.numeric(node$y)
    nw <- as.numeric(node$width)
    nh <- as.numeric(node$height)
    
    if (!all(is.finite(c(x, y, nw, nh)))) next
    
    left <- round(x - nw / 2)
    right <- round(x + nw / 2)
    top <- round(y - nh / 2)
    bottom <- round(y + nh / 2)
    
    if (status == "exclusive6") {
      
      img <- draw_solid_border(
        img, left, right, top, bottom,
        color_hex = "#D32F2F",
        border_width = border_width
      )
      
    } else if (status == "exclusive24") {
      
      img <- draw_solid_border(
        img, left, right, top, bottom,
        color_hex = "#1976D2",
        border_width = border_width
      )
      
    } else if (status == "shared") {
      
      img <- draw_solid_border(
        img, left, right, top, bottom,
        color_hex = "#7B1FA2",
        border_width = border_width
      )
      
    } else if (status == "hetero_noshared") {
      
      img <- draw_dashed_border(
        img, left, right, top, bottom,
        color_hex = "#000000",
        border_width = border_width,
        dash_len = 10,
        gap_len = 6
      )
      
    } else if (status == "hetero_shared") {
      
      img <- draw_solid_border(
        img, left, right, top, bottom,
        color_hex = "#000000",
        border_width = border_width
      )
    }
    
    n_marked <- n_marked + 1L
    
    # Registrar genes que justifican la clasificación
    node_summary[[length(node_summary) + 1L]] <- data.frame(
      Treatment = treatment,
      Pathway_ID = pathway_id,
      Node_index = i,
      Node_genes = ids,
      LE_exclusive_6h = paste(
        intersect(genes_nodo, setdiff(le6, le24)),
        collapse = "; "
      ),
      LE_exclusive_24h = paste(
        intersect(genes_nodo, setdiff(le24, le6)),
        collapse = "; "
      ),
      LE_shared = paste(
        intersect(genes_nodo, intersect(le6, le24)),
        collapse = "; "
      ),
      Node_category = status,
      stringsAsFactors = FALSE
    )
  }
  
  message("Nodos con bordes asignados: ", n_marked)
  
  # 10. Guardar mapa final
  final_file <- file.path(
    trt_dir,
    paste0(pathway_id, "_shared_exclusive_map.png")
  )
  
  png::writePNG(img, final_file)
  
  # 11. Guardar tabla de nodos
  if (length(node_summary) > 0) {
    
    node_summary_df <- dplyr::bind_rows(node_summary)
    
    write.csv(
      node_summary_df,
      file.path(
        trt_dir,
        paste0(pathway_id, "_node_status_summary.csv")
      ),
      row.names = FALSE
    )
  }
  
  message("Mapa final guardado: ", final_file)
  
  return(invisible(final_file))
}


# Ejecutar mapas
for (trt in names(comparison_pairs)) {
  
  for (pathway_id in names(death_pathways)) {
    
    message("Procesando mapa shared/exclusive: ", trt, " | ", pathway_id)
    
    tryCatch(
      plot_kegg_shared_exclusive_map(
        treatment = trt,
        pathway_id = pathway_id,
        out_dir = "Mapas_shared_exclusive",
        border_width = 3
      ),
      error = function(e) {
        message("Error en ", trt, " | ", pathway_id, ": ", conditionMessage(e))
      }
    )
  }
}



# Heatmaps para figuras compuestas ----------------------------------------
# Tabla combinada 6h/24h
build_route_treatment_table <- function(treatment, pathway_id) {
  
  cmp6 <- comparison_pairs[[treatment]]$h6
  cmp24 <- comparison_pairs[[treatment]]$h24
  
  tab6 <- make_kegg_gene_table_allfc(cmp6, pathway_id)$genes %>%
    dplyr::select(
      ENTREZID, ENSEMBL, gene_name, gene_biotype,
      logFC, FDR, DEG, LeadingEdge
    ) %>%
    rename(
      logFC_6h = logFC,
      FDR_6h = FDR,
      DEG_6h = DEG,
      LE_6h = LeadingEdge
    )
  
  tab24 <- make_kegg_gene_table_allfc(cmp24, pathway_id)$genes %>%
    dplyr::select(
      ENTREZID, ENSEMBL, gene_name, gene_biotype,
      logFC, FDR, DEG, LeadingEdge
    ) %>%
    rename(
      logFC_24h = logFC,
      FDR_24h = FDR,
      DEG_24h = DEG,
      LE_24h = LeadingEdge
    )
  
  merged <- full_join(
    tab6,
    tab24,
    by = c("ENTREZID", "ENSEMBL", "gene_name", "gene_biotype")
  ) %>%
    mutate(
      LE_6h = ifelse(is.na(LE_6h), FALSE, LE_6h),
      LE_24h = ifelse(is.na(LE_24h), FALSE, LE_24h),
      DEG_6h = ifelse(is.na(DEG_6h), FALSE, DEG_6h),
      DEG_24h = ifelse(is.na(DEG_24h), FALSE, DEG_24h),
      category = case_when(
        LE_6h & LE_24h ~ "Compartido",
        LE_6h & !LE_24h ~ "Exclusivo 6h",
        !LE_6h & LE_24h ~ "Exclusivo 24h",
        TRUE ~ "No LE"
      ),
      priority = case_when(
        category == "Compartido" ~ 1,
        category == "Exclusivo 6h" ~ 2,
        category == "Exclusivo 24h" ~ 3,
        TRUE ~ 4
      ),
      best_fdr = pmin(FDR_6h, FDR_24h, na.rm = TRUE),
      best_abs_logFC = pmax(abs(logFC_6h), abs(logFC_24h), na.rm = TRUE)
    ) %>%
    arrange(priority, best_fdr, desc(best_abs_logFC))
  
  return(merged)
}

# Generar plots
plot_heatmap_top10_route <- function(treatment,
                                     pathway_id,
                                     out_dir = "Heatmaps_top10_logFC",
                                     top_n = 10,
                                     limit_logFC = 0.5) {
  
  dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
  trt_dir <- file.path(out_dir, treatment, pathway_id)
  dir.create(trt_dir, recursive = TRUE, showWarnings = FALSE)
  
  merged <- build_route_treatment_table(treatment, pathway_id)
  
  # seleccionar genes LE prioritarios
  selected <- merged %>%
    filter(category != "No LE") %>%
    slice_head(n = top_n)
  
  if (nrow(selected) == 0) {
    message("No hay genes LE para heatmap en ", treatment, " | ", pathway_id)
    return(NULL)
  }
  
  # si faltan genes, completar con genes de ruta
  if (nrow(selected) < top_n) {
    faltan <- top_n - nrow(selected)
    
    extra <- merged %>%
      filter(!(ENTREZID %in% selected$ENTREZID)) %>%
      slice_head(n = faltan)
    
    selected <- bind_rows(selected, extra)
  }
  
  # matriz de logFC
  mat <- selected %>%
    dplyr::select(logFC_6h, logFC_24h) %>%
    as.matrix()
  
  rownames(mat) <- ifelse(
    is.na(selected$gene_name) | selected$gene_name == "",
    selected$ENTREZID,
    selected$gene_name
  )
  
  colnames(mat) <- c("6 h", "24 h")
  
  # limitar visualización
  mat_plot <- mat
  mat_plot[mat_plot > limit_logFC] <- limit_logFC
  mat_plot[mat_plot < -limit_logFC] <- -limit_logFC
  
  annotation_row <- data.frame(
    Categoria = selected$category,
    row.names = rownames(mat_plot)
  )
  
  ann_colors <- list(
    Categoria = c(
      "Compartido" = "#7B1FA2",
      "Exclusivo 6h" = "#D32F2F",
      "Exclusivo 24h" = "#1976D2",
      "No LE" = "#BDBDBD"
    )
  )
  
  out_png <- file.path(
    trt_dir,
    paste0(pathway_id, "_heatmap_top", top_n, "_logFC.png")
  )
  
  pheatmap::pheatmap(
    mat_plot,
    color = logfc_palette,
    breaks = seq(-limit_logFC, limit_logFC, length.out = 101),
    cluster_rows = TRUE,
    cluster_cols = FALSE,
    annotation_row = annotation_row,
    annotation_colors = ann_colors,
    border_color = "white",
    fontsize_row = 8,
    fontsize_col = 10,
    main = paste0(
      death_pathways[[pathway_id]],
      " | ",
      comparison_pairs[[treatment]]$label,
      " | Top ",
      top_n,
      " genes"
    ),
    filename = out_png,
    width = 4,
    height = 5
  )
  
  # guardar tabla de respaldo
  write.csv(
    selected,
    file.path(
      trt_dir,
      paste0(pathway_id, "_heatmap_top", top_n, "_genes.csv")
    ),
    row.names = FALSE
  )
  
  return(invisible(out_png))
}

# Ejecutr plots
for (trt in names(comparison_pairs)) {
  
  for (pathway_id in names(death_pathways)) {
    
    message("Procesando heatmap: ", trt, " | ", pathway_id)
    
    tryCatch(
      plot_heatmap_top10_route(
        treatment = trt,
        pathway_id = pathway_id,
        out_dir = "Heatmaps_top10_logFC",
        top_n = 10,
        limit_logFC = 0.5
      ),
      error = function(e) {
        message("Error en ", trt, " | ", pathway_id, ": ", conditionMessage(e))
      }
    )
  }
}






