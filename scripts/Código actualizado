# Conversión a Entrez
head(annotation$gene_id)

gene_conversion <- bitr(
  rownames(dge),
  fromType = "ENSEMBL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db
)

nrow(gene_conversion)
head(gene_conversion)

# Ambiente
universe_entrez <- unique(gene_conversion$ENTREZID)



# Estadístico F - logFC
rank <- function(result) {
  
  ranking <- sign(result$logFC)*sqrt(result$F)#~1.3% genes con empate de ranking
  
  names(ranking) <- rownames(result)
  
  ranking <- ranking[
    is.finite(ranking)
  ]
  
  ranking <- sort(
    ranking,
    decreasing = TRUE
  )
  
  return(ranking)
}


# Convertir ranking a ENTREZID
library(BiocParallel)

register(SerialParam())


make_entrez_ranking <- function(result) {
  
  ranking <- rank(result)
  
  ranking_df <- data.frame(
    gene_id = names(ranking),
    score = as.numeric(ranking),
    stringsAsFactors = FALSE
  )
  
  ranking_df <- ranking_df %>%
    inner_join(
      gene_conversion,
      by = c("gene_id" = "ENSEMBL")
    )
  
  ranking_df <- ranking_df %>%
    filter(!is.na(ENTREZID)) %>%
    group_by(ENTREZID) %>%
    slice_max(
      order_by = abs(score),
      n = 1,
      with_ties = FALSE
    ) %>%
    ungroup()
  
  ranking <- ranking_df$score
  names(ranking) <- ranking_df$ENTREZID
  
  ranking <- sort(
    ranking,
    decreasing = TRUE
  )
  
  return(ranking)
}

ranking_test <- make_entrez_ranking(
  results[["etoh_6_vs_control_6"]]
)
gsea_test <- gseGO(
  geneList = ranking_test,
  OrgDb = org.Hs.eg.db,
  keyType = "ENTREZID",
  ont = "BP",
  minGSSize = 10,
  maxGSSize = 500,
  pvalueCutoff = 0.05,
  pAdjustMethod = "BH",
  verbose = TRUE
)
head(gsea_test@result)
sum(gsea_test@result$p.adjust < 0.05)



# GSEA - GO
library(BiocParallel)

register(SerialParam())

gsea_go <- lapply(
  results,
  function(result) {
    
    ranking <- make_entrez_ranking(result)
    
    gseGO(
      geneList = ranking,
      OrgDb = org.Hs.eg.db,
      keyType = "ENTREZID",
      ont = "BP",
      minGSSize = 10,
      maxGSSize = 500,
      pvalueCutoff = 0.05,
      pAdjustMethod = "BH",
      eps = 0,
      nPermSimple = 10000,
      verbose = FALSE
    )
  }
)

lapply(
  gsea_go,
  function(x) {
    sum(x@result$p.adjust < 0.05)
  }
)

dotplot(
  gsea_go[["etoh_6_vs_control_6"]],
  showCategory = 20
)



# Ejemplo
gsea_go[["etoh_6_vs_control_6"]]


# Tablas de resultados
gsea_go_df <- lapply(
  gsea_go,
  as.data.frame
)

# Visualización ejemplo
head(
  gsea_go_df[["etoh_6_vs_control_6"]]
)


# GSEA de KEGG
gsea_kegg <- lapply(
  results,
  function(result) {
    
    ranking <- make_entrez_ranking(result)
    
    gseKEGG(
      geneList = ranking,
      organism = "hsa",
      minGSSize = 10,
      maxGSSize = 500,
      pvalueCutoff = 0.05,
      pAdjustMethod = "BH",
      verbose = FALSE
    )
  }
)

names(gsea_kegg) <- names(results)

gsea_kegg_df <- lapply(
  gsea_kegg,
  as.data.frame
)


