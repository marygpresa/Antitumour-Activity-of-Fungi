# Volcano plot
crear_volcano_kegg <- function(nombre_contraste, titulo) {
  
  res <- results[[nombre_contraste]]
  
  # Seleccionar genes significativos pertenecientes a rutas KEGG
  genes_etiquetar <- res |>
    dplyr::filter(
      !is.na(FDR),
      FDR < 0.05,
      abs(logFC) >= 1,
      !is.na(gene_name),
      gene_name != "",
      gene_name %in% genes_kegg_simbolos
    ) |>
    dplyr::distinct(gene_name, .keep_all = TRUE) |>
    dplyr::arrange(FDR, dplyr::desc(abs(logFC))) |>
    dplyr::group_by(logFC > 0) |>
    dplyr::slice_head(n = 10) |>
    dplyr::ungroup() |>
    dplyr::pull(gene_name)
  
  set.seed(123)
  
  EnhancedVolcano(
    res,
    lab = res$gene_name,
    selectLab = genes_etiquetar,
    x = "logFC",
    y = "FDR",
    pCutoff = 0.05,
    FCcutoff = 1,
    title = titulo,
    drawConnectors = TRUE,
    max.overlaps = Inf
  )
}


# Comprobación------------------------------------------------------------------
# Evaluación de contraste
contraste <- "etoh_6_vs_control_6"

res <- results[[contraste]]

genes_seleccionados <- res |>
  dplyr::filter(
    !is.na(FDR),
    FDR < 0.05,
    abs(logFC) >= 1,
    !is.na(gene_name),
    gene_name != "",
    gene_name %in% genes_kegg_simbolos
  ) |>
  dplyr::distinct(gene_name, .keep_all = TRUE) |>
  dplyr::arrange(FDR, dplyr::desc(abs(logFC))) |>
  dplyr::mutate(
    direccion = ifelse(logFC > 0, "Sobreexpresado",
                       "Subexpresado"),
    rutas_KEGG = vapply(
      gene_name,
      function(g) paste(
        tabla_genes_kegg$Ruta[
          tabla_genes_kegg$Simbolo == g
        ],
        collapse = "; "
      ),
      character(1)
    )
  )

genes_seleccionados |>
  dplyr::select(
    gene_name, logFC, FDR, direccion, rutas_KEGG
  ) |>
  as.data.frame() |>
  print()


# Consultar los genes de cada ruta directamente en KEGG
comprobar_kegg <- lapply(names(rutas_kegg), function(nombre_ruta) {
  
  entrada <- KEGGREST::keggGet(
    rutas_kegg[[nombre_ruta]]
  )[[1]]
  
  genes <- entrada$GENE
  
  ids <- genes[seq(1, length(genes), by = 2)]
  descripciones <- genes[seq(2, length(genes), by = 2)]
  
  data.frame(
    Ruta = nombre_ruta,
    Entrez = ids,
    Simbolo = trimws(sub(";.*$", "", descripciones)),
    stringsAsFactors = FALSE
  )
})

tabla_kegg_verificada <- do.call(rbind, comprobar_kegg)

# Consultar los cinco genes de tu resultado
genes_revisar <- c("SPATA2", "DDIT4", "JUN", "FOS", "THBS1")

tabla_kegg_verificada |>
  dplyr::filter(Simbolo %in% genes_revisar) |>
  dplyr::arrange(Simbolo, Ruta) |>
  print()

# Verificación tabla generada y tabla kegg
asignaciones_originales <- genes_seleccionados |>
  dplyr::select(gene_name, rutas_KEGG) |>
  dplyr::distinct() |>
  dplyr::mutate(
    Ruta_original = strsplit(rutas_KEGG, "; ")
  ) |>
  tidyr::unnest(Ruta_original)

comprobacion <- asignaciones_originales |>
  dplyr::mutate(
    Confirmada = mapply(
      function(gen, ruta) {
        any(
          tabla_kegg_verificada$Simbolo == gen &
            tabla_kegg_verificada$Ruta == ruta
        )
      },
      gene_name,
      Ruta_original
    )
  )

print(as.data.frame(comprobacion), row.names = FALSE)



