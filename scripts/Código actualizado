      function(gen, ruta) {
        any(
          tabla_kegg_verificada$Simbolo == gen &
            tabla_kegg_verificada$Ruta == ruta
        )
      },
      gene_name,
      Ruta_original
    )
  )

print(as.data.frame(comprobacion), row.names = FALSE)



################################################################################
#--------------------------------------Heatmap----------------------------------
# Heatmap automático de condiciones
plot_deg_heatmap <- function(
    comparison,
    n_genes = 50) {
  
  result <- DEGs[[comparison]]
  
  if (nrow(result) == 0) {
    message(
      "No hay DEGs para ",
      comparison,
      " con FDR < 0.05 y |logFC| >= 1."
    )
    return(NULL)
  }
  
  # Ordenar por FDR
  result <- result[
    order(result$FDR),
  ]
  
  # Seleccionar hasta n_genes
  top_genes <- head(
    rownames(result),
    n_genes
  )
  
  # Identificar automáticamente las condiciones del contraste
  contrast_conditions <- rownames(contrast)[
    contrast[, comparison] != 0
  ]
  
  selected_samples <- groups$sample[
    groups$condition %in%
      contrast_conditions
  ]
  
  heatmap_matrix <- logCPM[
    top_genes,
    selected_samples,
    drop = FALSE
  ]
  
  # Convertir a matriz numérica
  heatmap_matrix <- as.matrix(heatmap_matrix)
  
  # Z-score por gen para visualizar patrones relativos
  heatmap_matrix <- t(
    scale(
      t(heatmap_matrix)
    )
  )
  
  # Eliminar genes con varianza cero, si los hubiera
  heatmap_matrix <- heatmap_matrix[
    apply(
      heatmap_matrix,
      1,
      function(x) all(is.finite(x))
    ),
    ,
    drop = FALSE
  ]
  
  # Nombre de genes para las filas
  gene_names <- annotation$gene_name[
    match(
      rownames(heatmap_matrix),
      annotation$gene_id
    )
  ]
  
  gene_names[
    is.na(gene_names) |
      gene_names == ""
  ] <- rownames(heatmap_matrix)[
    is.na(gene_names) |
      gene_names == ""
  ]
  
  rownames(heatmap_matrix) <- make.unique(
    gene_names
  )
  
  annotation_heatmap <- as.data.frame(groups[
    match(
      colnames(heatmap_matrix),
      groups$sample
    ),
    c("treatment", "time"),
    drop = FALSE
  ]
  )
  
  rownames(annotation_heatmap) <-
    colnames(heatmap_matrix)
  
  pheatmap(
    heatmap_matrix,
    annotation_col = annotation_heatmap,
    show_colnames = TRUE,
    fontsize_col = 7,
    fontsize_row = 7,
    main = paste0(
      "Top ",
      nrow(heatmap_matrix),
      " DEGs - ",
      comparison
    )
  )
}


# Gráficos
