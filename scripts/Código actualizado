  ) |>
  as.data.frame() |>
  print()


# Consultar los genes de cada ruta directamente en KEGG
comprobar_kegg <- lapply(names(rutas_kegg), function(nombre_ruta) {
  
  entrada <- KEGGREST::keggGet(
    rutas_kegg[[nombre_ruta]]
  )[[1]]
  
  genes <- entrada$GENE
  
  ids <- genes[seq(1, length(genes), by = 2)]
  descripciones <- genes[seq(2, length(genes), by = 2)]
  
  data.frame(
    Ruta = nombre_ruta,
    Entrez = ids,
    Simbolo = trimws(sub(";.*$", "", descripciones)),
    stringsAsFactors = FALSE
  )
})

tabla_kegg_verificada <- do.call(rbind, comprobar_kegg)

