# ============================================================
# MAPAS KEGG - DEG Y LEADING EDGE
# ============================================================

library(pathview)
library(dplyr)
library(png)

dir.create("Mapas_KEGG_GSEA", showWarnings = FALSE)


# 1. Preparar resultados de expresión diferencial

prepare_kegg_genes <- function(comparison) {
  
  result <- results[[comparison]]
  
  if (is.null(result)) {
    stop("Comparación no encontrada: ", comparison)
  }
  
  genes_df <- data.frame(
    ENSEMBL = sub("\\..*$", "", rownames(result)),
    Gene = result$gene_name,
    logFC = result$logFC,
    PValue = result$PValue,
    FDR = result$FDR,
    stringsAsFactors = FALSE
  )
  
  genes_df <- genes_df %>%
    dplyr::inner_join(
      gene_conversion %>%
        dplyr::select(ENSEMBL, ENTREZID) %>%
        dplyr::distinct(),
      by = "ENSEMBL"
    ) %>%
    dplyr::filter(
      !is.na(ENTREZID),
      is.finite(logFC)
    ) %>%
    dplyr::arrange(
      ENTREZID,
      dplyr::desc(abs(logFC)),
      ENSEMBL
    ) %>%
    dplyr::distinct(ENTREZID, .keep_all = TRUE) %>%
    dplyr::mutate(
      ENTREZID = as.character(ENTREZID),
      
      DEG = !is.na(FDR) &
        FDR < 0.05 &
        abs(logFC) >= 1,
      
      Regulation = dplyr::case_when(
        DEG & logFC > 0 ~ "Upregulated",
        DEG & logFC < 0 ~ "Downregulated",
        TRUE ~ "No DEG"
      ),
      
      logFC_plot = ifelse(DEG, logFC, NA_real_)
    )
  
  return(genes_df)
}


# 2. Preparar tabla de genes y leading edge

make_kegg_gene_table <- function(comparison, pathway_id) {
  
  genes_df <- prepare_kegg_genes(comparison)
  gsea_obj <- gsea_kegg_death[[comparison]]
  
  if (is.null(gsea_obj)) {
    stop("Sin resultados GSEA: ", comparison)
  }
  
  gsea_df <- as.data.frame(gsea_obj)
  
  pathway_row <- gsea_df[
    !is.na(gsea_df$ID) &
      gsea_df$ID == pathway_id,
    ,
    drop = FALSE
  ]
  
  if (nrow(pathway_row) == 0) {
    stop("Ruta no disponible en GSEA: ", pathway_id)
  }
  
  pathway_genes <- gsea_obj@geneSets[[pathway_id]]
  
  if (is.null(pathway_genes)) {
    stop("Conjunto de genes no disponible: ", pathway_id)
  }
  
  core <- pathway_row$core_enrichment[1] # Extraigo los LE
  
  leading_genes <- if (!is.na(core) && nzchar(core)) {
    strsplit(core, "/", fixed = TRUE)[[1]]
  } else {
    character(0)
  }
  
  tabla <- genes_df %>% # Los clasifico
    dplyr::filter(
      ENTREZID %in% as.character(pathway_genes)
    ) %>%
    dplyr::mutate(
      LeadingEdge = ENTREZID %in% leading_genes,
      
      Categoria = dplyr::case_when(
        DEG & LeadingEdge ~ "DEG + Leading edge",
        DEG & !LeadingEdge ~ "Solo DEG",
        !DEG & LeadingEdge ~ "Solo leading edge",
        TRUE ~ "Ninguno"
      ),
      
      NES_ruta = pathway_row$NES[1], 
      FDR_GSEA = pathway_row$p.adjust[1], 
      Comparison = comparison,
      KEGG_ID = pathway_id,
      .before = 1
    ) %>%
    dplyr::arrange(
      dplyr::desc(LeadingEdge),
      dplyr::desc(DEG),
      FDR
    ) # Primero van los que son LE y DEG y por último por FDR
  
  return(list(
    genes = tabla,
    leading_ids = leading_genes
  ))
}


# 3. Añadir bordes negros a nodos del leading edge

add_leading_edge_borders <- function(
    image_file,
    plot_data,
    leading_ids,
    output_file,
    border_width = 3
) {
  
  img <- png::readPNG(image_file)
  
  h <- dim(img)[1]
  w <- dim(img)[2]
  
  # Identificar genes de cada nodo KEGG
  node_ids <- if ("all.mapped" %in% names(plot_data)) {
    as.character(plot_data$all.mapped)
  } else {
    as.character(plot_data$kegg.names)
  }
  
  has_leading <- vapply(
    node_ids,
    function(ids) {
      
      if (is.na(ids) || !nzchar(ids)) {
        return(FALSE)
      }
      
      genes_nodo <- trimws(
        unlist(strsplit(ids, "[,;/[:space:]]+"))
      )
      
      any(genes_nodo %in% leading_ids)
    },
    logical(1)
  )
  
  selected_nodes <- plot_data[
    has_leading,
    ,
    drop = FALSE
  ]
  
  # Dibujar bordes en la imagen
  paint_black <- function(rows, cols) {
    
    rows <- rows[rows >= 1 & rows <= h]
    cols <- cols[cols >= 1 & cols <= w]
    
    if (!length(rows) || !length(cols)) {
      return(invisible(NULL))
    }
    
    for (ch in 1:3) {
      img[rows, cols, ch] <<- 0
    }
    
    if (dim(img)[3] == 4) {
      img[rows, cols, 4] <<- 1
    }
  }
  
  n_marked <- 0L
  
  for (i in seq_len(nrow(selected_nodes))) {
    
    node <- selected_nodes[i, ]
    
    x <- as.numeric(node$x)
    y <- as.numeric(node$y)
    nw <- as.numeric(node$width)
    nh <- as.numeric(node$height)
    
    if (!all(is.finite(c(x, y, nw, nh)))) next
    
    left <- round(x - nw / 2)
    right <- round(x + nw / 2)
    top <- round(y - nh / 2)
    bottom <- round(y + nh / 2)
    
    for (b in seq_len(border_width) - 1L) {
      
      paint_black(top + b, left:right)
      paint_black(bottom - b, left:right)
      
      paint_black(top:bottom, left + b)
      paint_black(top:bottom, right - b)
    }
    
    n_marked <- n_marked + 1L
  }
  
  png::writePNG(img, output_file)
  
  return(n_marked)
}


# 4. Generar mapa y tabla por ruta

plot_kegg_integrated <- function(
    comparison,
    pathway_id,
    limit_logFC = 3
) {
  
  info <- make_kegg_gene_table(
    comparison,
    pathway_id
  )
  
  tabla <- info$genes
  
  carpeta <- file.path(
    "Mapas_KEGG_GSEA",
    comparison
  )
  
  dir.create(
    carpeta,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  # Guardar tabla de genes
  write.csv(
    tabla,
    file.path(
      carpeta,
      paste0(pathway_id, "_genes.csv")
    ),
    row.names = FALSE
  )
  
  # Valores utilizados para el color de los nodos
  gene_values <- tabla$logFC_plot
  names(gene_values) <- tabla$ENTREZID
  
  suffix <- paste0(
    comparison, "_", pathway_id
  )
  
  # Generar mapa KEGG
  pv <- pathview::pathview(
    gene.data = gene_values,
    pathway.id = pathway_id,
    species = "hsa",
    gene.idtype = "entrez",
    kegg.native = TRUE,
    plot.col.key = TRUE,
    key.pos = "bottomright",
    
    na.col = "#D3D3D3",
    
    low = list(gene = "#2166AC"), #cpd es para metabolitos, no se usa
    mid = list(gene = "#F7F7F7"),
    high = list(gene = "#B2182B"),
    
    limit = list(gene = limit_logFC, cpd = 1),
    bins = list(gene = 100, cpd = 10),
    both.dirs = list(gene = TRUE, cpd = TRUE),
    
    node.sum = "max.abs", # Se presenta el logFC más alto para el nodo de los diferentes genes
    
    out.suffix = suffix,
    kegg.dir = "Mapas_KEGG_GSEA"
  )
  
  if (is.null(pv$plot.data.gene)) {
    stop("No se generaron los nodos de la ruta.")
  }
  
  original_file <- paste0(
    pathway_id, ".", suffix, ".png"
  )
  
  if (!file.exists(original_file)) {
    stop("No se encontró el mapa original.")
  }
  
  final_file <- file.path(
    carpeta,
    paste0(pathway_id, "_DEG_LE.png")
  )
  
  n_marked <- add_leading_edge_borders(
    image_file = original_file,
    plot_data = pv$plot.data.gene,
    leading_ids = info$leading_ids,
    output_file = final_file
  )
  
  # Conservar solamente el mapa final
  if (file.exists(final_file)) {
    file.remove(original_file)
  }
  
  message(
    "Mapa generado: ", comparison,
    " | ", pathway_id,
    " | Nodos marcados: ", n_marked
  )
  
  return(invisible(final_file))
}


# 5. Generar mapas de todas las rutas y comparaciones

for (comparison in comparisons_gsea) {
  
  for (pathway_id in names(death_pathways)) {
    
    message(
      "\nProcesando: ",
      comparison,
      " | ",
      death_pathways[[pathway_id]]
    )
    
    tryCatch(
      
      plot_kegg_integrated(
        comparison = comparison,
        pathway_id = pathway_id,
        limit_logFC = 3
      ),
      
      error = function(e) {
        message(
          "Error en ", comparison,
          " | ", pathway_id,
          ": ", conditionMessage(e)
        )
      }
    )
  }
}

# Si quiero ver las tablas que incluyen DEGs y Leading genes
View(read.csv("Mapas_KEGG_GSEA/lipof_24_vs_vehicle_24/hsa04217_genes.csv"))

