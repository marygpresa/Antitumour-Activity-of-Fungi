# Gráfico Heatmaps de correlación
plot_correlation_heatmap <- function(
    expression_matrix,
    title) {
  
  expresion_matrix <- as.matrix(expression_matrix)
  
  correlation_matrix <- cor(
    expression_matrix
  )
  
  annotation_samples <- as.data.frame(
    groups[
      match(
        colnames(correlation_matrix),
        groups$sample
      ),
      c("treatment", "time"),
      drop = FALSE
    ]
  )
  
    rownames(annotation_samples) <-
    colnames(correlation_matrix)
  
  pheatmap(
    correlation_matrix,
    annotation_col = annotation_samples,
    annotation_row = annotation_samples,
    main = title
  )
}


#-------------------------------------------------------------------------------
# Prueba con colores en lugar de etiquetas, pero este es para el general
plot_correlation_heatmap <- function(
    expression_matrix,
    title) {
  
  expression_matrix <- as.matrix(expression_matrix)
  
  correlation_matrix <- cor(expression_matrix)
  
  # Obtener la información de cada muestra
  annotation_samples <- data.frame(
    Condición = groups$condition[
      match(
        colnames(correlation_matrix),
        groups$sample
      )
    ]
  )
  
  rownames(annotation_samples) <- colnames(correlation_matrix)
  colnames(annotation_samples) <- "Condición"
  
  # Colores para cada condición
  colores_condicion <- c(
    control_6  = "#BA68CB",
    control_24 = "#FFB74D",
    etoh_6     = "#1976D2",
    etoh_24    = "#81C7B4"
  )
  
  # Ocultar nombres de muestras y mostrar leyenda
  pheatmap::pheatmap(
    correlation_matrix,
    annotation_col = annotation_samples,
    annotation_row = annotation_samples,
    annotation_colors = list(
      Condición = colores_condicion
    ),
    labels_col = rep("", ncol(correlation_matrix)),
    labels_row = rep("", nrow(correlation_matrix)),
    show_colnames = FALSE,
    show_rownames = FALSE,
    main = title
  )
}

