# Filtración con simplify GO-GSEA-----------------------------------------------
# 1. REDUCCIÓN DE REDUNDANCIA EN GO-BP


library(clusterProfiler)
library(dplyr)
library(ggplot2)

gsea_go_simplified <- lapply(
  gsea_go,
  function(x) {
    
    if (is.null(x) || nrow(as.data.frame(x)) < 2) {
      return(x)
    }
    
    clusterProfiler::simplify(
      x,
      cutoff = 0.7,
      by = "p.adjust",
      select_fun = min,
      measure = "Wang"
    )
  }
)

# Crear tablas simplificadas
gsea_go_simplified_df <- lapply(
  gsea_go_simplified,
  as.data.frame
)

# Comparar cantidad de términos antes y después
data.frame(
  Comparacion = names(gsea_go),
  GO_original = sapply(gsea_go_df, nrow),
  GO_simplificado = sapply(gsea_go_simplified_df, nrow)
)

# COMPARACIÓN TOP 10 GO ORIGINAL VS SIMPLIFICADO


get_top_go <- function(df) {
  
  df %>%
    filter(
      !is.na(p.adjust),
      p.adjust < 0.05,
      !is.na(NES),
      is.finite(NES)
    ) %>%
    slice_max(
      order_by = abs(NES),
      n = 10,
      with_ties = FALSE
    )
}

comparison_simplify <- data.frame(
  Comparacion = names(results),
  
  GO_original = sapply(
    gsea_go_df,
    function(x) nrow(get_top_go(x))
  ),
  
  GO_simplificado = sapply(
    gsea_go_simplified_df,
    function(x) nrow(get_top_go(x))
  ),
  
  Rutas_compartidas = sapply(
    names(results),
    function(comparison) {
      
      original <- get_top_go(
        gsea_go_df[[comparison]]
      )$ID
      
      simplified <- get_top_go(
        gsea_go_simplified_df[[comparison]]
      )$ID
      
      length(intersect(original, simplified))
    }
  )
)

comparison_simplify



