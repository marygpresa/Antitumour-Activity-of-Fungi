# BARPLOTS GSEA COMBINADOS - GO SIMPLIFICADO + KEGG + REACTOME
# Gráficos combinados con selección de rutas

library(dplyr)
library(ggplot2)
library(stringr)

combine_gsea_simplified_select <- function(comparison) {
  
  # 1. Combinar las tres bases de datos
  go <- gsea_go_simplified_df[[comparison]] |>
    mutate(Database = "GO BP")
  
  kegg <- gsea_kegg_df_depurado[[comparison]] |>
    mutate(Database = "KEGG")
  
  reactome <- gsea_reactome_df_depurado[[comparison]] |>
    mutate(Database = "Reactome")
  
  df <- bind_rows(go, kegg, reactome) |>
    filter(
      !is.na(p.adjust),
      p.adjust < 0.05,
      !is.na(NES),
      is.finite(NES)
    )
  
  if (nrow(df) == 0) {
    return(df)
  }
  
  # 2. Palabras clave de rutas de muerte celular
  terminos_muerte <- paste(
    c(
      "apoptosis",
      "necroptosis",
      "ferroptosis",
      "pyroptosis",
      "autophagy",
      "autophagosome",
      "programmed cell death",
      "cell death",
      "necrosis",
      "caspase",
      "death receptor",
      "anoikis",
      "inflammasome"
    ),
    collapse = "|"
  )
  
  # 3. Rutas asociadas con daño, estrés y proliferación
  terminos_asociados <- paste(
    c(
      "cell cycle",
      "DNA damage",
      "DNA repair",
      "p53",
      "cellular senescence",
      "oxidative stress",
      "reactive oxygen species",
      "mitochondrial dysfunction",
      "unfolded protein response",
      "endoplasmic reticulum stress",
      "ER stress",
      "TNF signaling",
      "death signaling",
      "cell survival",
      "apoptotic signaling"
    ),
    collapse = "|"
  )
  
  # 4. Clasificar las rutas por relevancia
  df <- df |>
    mutate(
      Priority = case_when(
        grepl(
          terminos_muerte,
          Description,
          ignore.case = TRUE
        ) ~ 2L,
        
        grepl(
          terminos_asociados,
          Description,
          ignore.case = TRUE
        ) ~ 1L,
        
        TRUE ~ 0L
      ),
      
      Categoria = case_when(
        Priority == 2L ~ "Muerte celular",
        Priority == 1L ~ "Procesos asociados",
        TRUE ~ "Otros procesos"
      )
    )
  
  # 5. Seleccionar hasta 10 rutas por base de datos
  df <- df |>
    group_by(Database) |>
    arrange(
      desc(Priority),
      p.adjust,
      desc(abs(NES)),
      .by_group = TRUE
    ) |>
    slice_head(n = 6) |>
    ungroup()
  
  # 6. Calcular número de genes leading edge
  df <- df |>
    mutate(
      LeadingEdge_n = vapply(
        strsplit(
          as.character(core_enrichment),
          "/",
          fixed = TRUE
        ),
        function(x) {
          sum(!is.na(x) & nzchar(x))
        },
        integer(1)
      ),
      
      Gene_label = paste0(
        LeadingEdge_n,
        "/",
        setSize
      ),
      
      Pathway_ID = Description
    )
  
  return(df)
}


# Aplicar a todas las comparaciones
gsea_combined_simplified_select <- lapply(
  names(results),
  combine_gsea_simplified_select
)

names(gsea_combined_simplified_select) <- names(results)

# Generar gráficos
plot_gsea_bar_simplified_select <- function(comparison) {
  
  df <- gsea_combined_simplified_select[[comparison]]
  
  if (is.null(df) || nrow(df) == 0) {
    message("Sin pathways significativos: ", comparison)
    return(NULL)
  }
  
  ggplot(
    df,
    aes(
      x = NES,
      y = reorder(
        stringr::str_wrap(Description, width = 60),
        NES
      ),
      fill = Database
    )
  ) +
    geom_vline(
      xintercept = 0,
      linetype = "dashed",
      color = "grey60"
    ) +
    annotate(
      "text",
      x = -Inf,
      y = Inf,
      label = "B",
      hjust = -0.5,
      vjust = 1.5,
      size = 6,
      fontface = "bold"
    ) +
    geom_col(width = 0.7) +
    geom_text(
      aes(
        label = Gene_label,
        hjust = ifelse(NES > 0, -0.1, 1.1)
      ),
      size = 4,
      family = "Times New Roman",
      fontface = "bold",
      show.legend = FALSE
    ) +
    scale_x_continuous(
      expand = expansion(mult = c(0.25, 0.30))
    ) +
    labs(
      title = paste(
        "GSEA priorizado por procesos de muerte celular",
        comparison,
        sep = "\n"
      ),
      x = "Normalized Enrichment Score (NES)",
      y = NULL,
      fill = "Base de datos",
      caption = "Etiquetas: genes leading edge / tamaño de la ruta"
    ) +
    theme_classic(base_size = 14) +
    theme(
      text = element_text(
        family = "Times New Roman",
        face = "bold"
      ),
      plot.title = element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16,
        hjust = 0.5
      ),
      axis.title.x = element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16
      ),
      axis.text.x = element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16
      ),
      axis.text.y = element_text(
        family = "Times New Roman",
        face = "bold",
        size = 13,
        lineheight = 0.9
      ),
      legend.title = element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16
      ),
      legend.text = element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16
      ),
      plot.caption = element_text(
        family = "Times New Roman",
        face = "bold",
        size = 12
      ),
      strip.text.y = element_text(
        family = "Times New Roman",
        face = "bold"
      ),
      legend.position = "bottom"
    ) +
    coord_cartesian(clip = "off") #+
    #theme(
     # plot.margin = margin(10, 25, 10, 10)
    #)
}

