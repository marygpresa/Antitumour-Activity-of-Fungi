packageVersion("edgeR")

# Semilla
set.seed(19)

# Carga de la matriz de expresión
expr <- read.delim(
  "7TK4C4-expression-matrix.tsv",
  header = TRUE,
  check.names = FALSE
)

#' Copia de la matriz
matrix_exp <- expr
dim(matrix_exp)

#' matriz de conteos
counts_matrix <- matrix_exp[, grepl("_count$", colnames(matrix_exp))]
rownames(counts_matrix) <- matrix_exp$gene_id

############################################################################
# Metadatos de muestras
sample_excel <- read_excel(
  "tube_codes_plasmidsaurus.xlsx",
  col_names = "excel_name"
)

sample_excel$sample_id <- seq_len(nrow(sample_excel))

# Extraer los identificadores de las muestras
sample_id <- as.numeric(
  sub("^7TK4C4_([0-9]+)_count$", "\\1", colnames(counts_matrix))
)

# Verificar
sample_id
length(sample_id)
anyNA(sample_id)



# Emparejar cada columna de la matriz con la fila correcta del Excel
groups <- sample_excel[
  match(sample_id, sample_excel$sample_id),
]

groups$original_sample <- colnames(counts_matrix)

# Verificar el emparejamiento
stopifnot(
  !anyNA(groups$excel_name),
  all(groups$original_sample == colnames(counts_matrix))
)

all(groups$original_sample == colnames(counts_matrix))
dim(groups)


################################################################################
# Separar tratamiento, tiempo y réplica --------------------------------------
# Tratamiento
groups$treatment <- ifelse(
  grepl("^Control", groups$excel_name, ignore.case = TRUE), "control",
  ifelse(
    grepl("^Vehicle", groups$excel_name, ignore.case = TRUE), "vehicle",
    ifelse(
      grepl("^etoh", groups$excel_name, ignore.case = TRUE), "etoh",
      ifelse(
        grepl("^lipofilic", groups$excel_name, ignore.case = TRUE), "lipof",
        NA
      )
    )
  )
)

# Tiempo
groups$time <- ifelse(
  grepl("_6h_", groups$excel_name), "6",
  ifelse(grepl("_24h_", groups$excel_name), "24", NA)
)

# Réplica
groups$replicate <- as.numeric(
  sub(".*_rep", "", groups$excel_name)
)


# Condiciones usadas en edgeR
groups$condition <- paste(
  groups$treatment,
  groups$time,
  sep = "_"
)

# Nombre en figuras
display_treatment <- ifelse(
  groups$treatment == "vehicle",
  "vehiculo",
  groups$treatment
)

groups$sample <- paste0(
  display_treatment, "_",
  groups$time, "h_rep",
  groups$replicate
)

# Mantener el orden exacto de las columnas
rownames(groups) <- groups$sample

# Comprobar que los metadatos estén completos
stopifnot(
  !anyNA(groups$treatment),
  !anyNA(groups$time),
  !anyNA(groups$replicate),
  !anyDuplicated(groups$sample)
)

table(groups$condition)
head(groups)



################################################################################
# Eliminar muestras que no se incluirán en el análisis--------------------------
# Identificar las muestras que se excluirán
muestras_excluir <- (
  (groups$treatment == "control" &
     groups$time == "6" &
     groups$replicate %in% c(1, 2, 6)) |
    (groups$treatment == "vehicle" &
       groups$time == "6" &
       groups$replicate %in% c(2, 3, 4, 5))
)
muestras_excluir

# Obtener los identificadores originales de las muestras
ids_excluir <- groups$sample_id[muestras_excluir]
ids_excluir

# Identificar las columnas de conteos y CPM que se eliminarán
columnas_excluir <- grep(
  paste0(
    "^7TK4C4_(",
    paste(ids_excluir, collapse = "|"),
    ")_(count|cpm)$"
  ),
  colnames(matrix_exp),
  value = TRUE
)

# Verificar las columnas identificadas
columnas_excluir

# Guardar los nombres de las muestras excluidas
muestras_eliminadas <- groups$sample[muestras_excluir]

# Actualizar los metadatos
groups <- groups[!muestras_excluir, ]

# Eliminar las columnas únicamente de matrix_exp
matrix_exp <- matrix_exp[
  ,
  !colnames(matrix_exp) %in% columnas_excluir,
  drop = FALSE
]

