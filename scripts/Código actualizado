################################################################################
# Diseño experimental -----------------------------------------------------
# Condiciones experimentales
groups$condition <- factor(groups$condition)

# Diseño de matriz
design <- model.matrix(~0 + condition, data = groups)
colnames(design) <- levels(groups$condition)


# Creación de las comparaciones a evaluar en edgeR
contrast <-limma::makeContrasts(
  etoh_6_vs_control_6 = etoh_6 - control_6,
  etoh_24_vs_control_24 = etoh_24 - control_24,
  lipof_6_vs_vehicle_6 = lipof_6 - vehicle_6,
  lipof_24_vs_vehicle_24 = lipof_24 - vehicle_24,
  vehicle_6_vs_control_6 = vehicle_6 - control_6,
  vehicle_24_vs_control_24 = vehicle_24 - control_24,
  etoh_6_vs_etoh_24 = etoh_6 - etoh_24,
  lipof_6_vs_lipof_24 = lipof_6 - lipof_24,
  
  levels = colnames(design)
)


# Evaluación de la creación de las comparaciones     ### Quitar S.M
View(contrast)
colnames(contrast)


################################################################################
# Análisis con edgeR ------------------------------------------------------
# Creación del objeto DGEList
dge <- DGEList(
  counts = counts_matrix,
  group = groups$condition
)
dge
dim(dge)


# Filtrar genes de baja expresión
keep <- filterByExpr(dge, design)
summary(keep)       # Quitar A.F
nrow(dge)           # Quitar A.F

dge <- dge[keep, , keep.lib.sizes = FALSE]   # 16683 genes
nrow(dge)       # Quitar A.F
dim(dge)        # Quitar A.F


# Normalización con TMM
dge <- calcNormFactors(dge)
dge$samples


# Estimación de la dispersión
dge <- estimateDisp(dge, design)
dge$common.dispersion
dge$tagwise.dispersion[1:10]

plotBCV(dge)

png(
  filename = "plotBCV.png",
  width = 2400,
  height = 1800,
  res = 300
)

plotBCV(dge)
dev.off()


# Ajustar el modelo estadístico quasi-likelihood
ajuste <- glmQLFit(dge, design)


# Verificación
dim(ajuste)
dim(dge)
dge$samples$norm.factors



# Ejecución de las comparaciones ------------------------------------------
# Ejecutar los contrastes
qlf_results <- lapply(
  colnames(contrast),
  function(x) {
    glmQLFTest(
      ajuste,
      contrast = contrast[, x]
    )
  }
)

names(qlf_results) <- colnames(contrast)


# Resultados --------------------------------------------------------------
# Obtención de los resultados de las comparaciones
results <- lapply(
  qlf_results,
  function(x) {
    topTags(x, n = Inf)$table
  }
)


# Anotación génica 
annotation <- matrix_exp[, c(
  "gene_id",
  "gene_name",
  "gene_biotype"
)]

results <- lapply(
  results,
  function(result) {
    result$gene_name <- annotation$gene_name[
      match(rownames(result), annotation$gene_id)
    ]
    
    result$gene_biotype <- annotation$gene_biotype[
      match(rownames(result), annotation$gene_id)
    ]
    
    result
  }
)


################################################################################
# Selección DEGs ----------------------------------------------------------
# Seleccionar genes diferencialmente expresados
DEGs <- lapply(
  results,
  function(result) {
    result[
      result$FDR < 0.05 &
        abs(result$logFC) >= 1,
    ]
  }
)

# Verificación
dim(DEGs[["etoh_6_vs_control_6"]]) # 1451 X 7                   No igual            Kathy 1468
dim(DEGs[["etoh_24_vs_control_24"]]) # 0 X 7
dim(DEGs[["lipof_6_vs_vehicle_6"]]) # 1032 X 7                  No igual                  1056
dim(DEGs[["lipof_24_vs_vehicle_24"]]) # 221 X 7
dim(DEGs[["vehicle_6_vs_control_6"]]) # 3 X 5 //// ahora da 3 X 7
dim(DEGs[["vehicle_24_vs_control_24"]]) # 31 X 7                No igual                  29
dim(DEGs[["etoh_6_vs_etoh_24"]]) # 183 X 7
dim(DEGs[["lipof_6_vs_lipof_24"]]) # 340 X 7                    No igual                  341

# Número de DEGs por comparación
deg_summary <- do.call(rbind, lapply(names(DEGs), function(comparacion) {
  
  tabla <- DEGs[[comparacion]]
  
  data.frame(
    comparison = comparacion,
    Total_DEGs = nrow(tabla),
    UP = sum(tabla$logFC >= 1, na.rm = TRUE),
    DOWN = sum(tabla$logFC <= -1, na.rm = TRUE)
  )
  
}))

rownames(deg_summary) <- NULL

deg_summary



# Guardar resultados ------------------------------------------------------
dir.create(
  "resultados_edgeR_depurado",
  showWarnings = FALSE
)

for (comparison in names(results)) {
  
  write.csv(
    results[[comparison]],
    file.path(
      "resultados_edgeR_depurado",
      paste0(comparison, "_todos_los_genes_depurado.csv")
    )
  )
  
  write.csv(
    DEGs[[comparison]],
    file.path(
      "resultados_edgeR_depurado",
      paste0(comparison, "_DEGs_depurado.csv")
    )
  )
}

write.csv(
  deg_summary,
  file.path("resultados_edgeR_depurado", "resumen_DEGs_depurado.csv"),
  row.names = FALSE
)


