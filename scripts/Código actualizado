# Volcano plot
install.packages("ggtext")
library(ggtext)

crear_volcano_kegg <- function(nombre_contraste, titulo) {
  
  res <- results[[nombre_contraste]]
  
  # Seleccionar genes significativos pertenecientes a rutas KEGG
  genes_etiquetar <- res |>
    dplyr::filter(
      !is.na(FDR),
      FDR < 0.05,
      abs(logFC) >= 1,
      !is.na(gene_name),
      gene_name != "",
      gene_name %in% genes_kegg_simbolos
    ) |>
    dplyr::distinct(gene_name, .keep_all = TRUE) |>
    dplyr::arrange(FDR, dplyr::desc(abs(logFC))) |>
    dplyr::group_by(logFC > 0) |>
    dplyr::slice_head(n = 10) |>
    dplyr::ungroup() |>
    dplyr::pull(gene_name)
  
  set.seed(123)
  
  p <- EnhancedVolcano(
    res,
    lab = res$gene_name,
    selectLab = genes_etiquetar,
    x = "logFC",
    y = "FDR",
    pCutoff = 0.05,
    FCcutoff = 1,
    title = titulo,
    drawConnectors = TRUE,
    max.overlaps = Inf,
    labSize = 4,
    labFace = "bold",
    labCol = "black",
    axisLabSize = 4.5,
    titleLabSize = 5
  ) +
    ggplot2::labs(
      x = "Log2FC",
      y = "p-value and log2FC"
    ) +
    ggplot2::theme(
      text = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold"
      ),
      plot.title = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16
      ),
      axis.title.x = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16
      ),
      axis.title.y = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold",
        size = 16
      ),
      axis.text.x = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold",
        size = 14
      ),
      axis.text.y = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold",
        size = 14
      ),
      legend.text = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold",
        size = 12
      ),
      legend.title = ggplot2::element_text(
        family = "Times New Roman",
        face = "bold",
        size = 12
      )
    )
  
  p$layers[[4]]$aes_params$family <- "Times New Roman"
  p$layers[[4]]$aes_params$fontface <- "bold"
  
  return(p)
}


